---
import type { Workflow } from '../data/workflow';

interface Props {
  workflow: Workflow;
}

const { workflow } = Astro.props;
---

<aside class="workflow-preview" aria-labelledby="workflow-preview-title">
  <div class="workflow-preview-copy">
    <p class="workflow-preview-kicker">How I build with agents</p>
    <h2 id="workflow-preview-title">{workflow.title}</h2>
    <p class="workflow-preview-description">{workflow.preview}</p>
  </div>
  <ol class="workflow-preview-trace" aria-label="Workflow stages">
    {
      workflow.stages.map((stage) => (
        <li>
          <span>{stage.label}</span>
        </li>
      ))
    }
  </ol>
  <a class="workflow-preview-link" href="#principles">
    Explore my AI workflow <span aria-hidden="true">↗</span>
  </a>
</aside>

<style>
  .workflow-preview {
    position: relative;
    display: block;
    min-width: 0;
    margin: 30px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    text-align: left;
  }
  .workflow-preview-kicker {
    margin: 0 0 8px;
    font: 500 10px/1.5 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber-deep);
  }
  .workflow-preview h2 {
    margin: 0;
    color: var(--ink);
    font: 500 clamp(25px, 3vw, 34px)/1.15 var(--font-serif);
    letter-spacing: -0.025em;
    text-transform: none;
  }
  .workflow-preview-description {
    max-width: 58ch;
    margin: 8px 0 0;
    color: var(--ink-2);
    font: 400 14px/1.6 var(--font-sans);
  }
  .workflow-preview-trace {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
    list-style: none;
    padding: 0;
    margin: 18px 0;
    color: var(--ink-2);
    font: 400 11px/1.6 var(--font-mono);
  }
  .workflow-preview-trace li {
    display: flex;
    align-items: center;
  }
  .workflow-preview-trace li:not(:last-child)::after {
    content: '→';
    margin: 0 9px;
    color: var(--amber-deep);
  }
  .workflow-preview-link {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    min-height: 44px;
    box-sizing: border-box;
    padding-block: 7px;
    color: var(--ink);
    font: 500 13px/1.5 var(--font-sans);
    text-decoration: underline;
    text-decoration-color: var(--amber-deep);
    text-underline-offset: 5px;
  }
  .workflow-preview-link:focus-visible {
    outline: 2px solid var(--amber-deep);
    outline-offset: 4px;
  }
  :global(html[data-reel]:not([data-reel='house'])) .workflow-preview {
    width: 80%;
    max-width: 1050px;
    margin: 42px auto 0;
    padding-top: 24px;
  }
  @media (max-width: 760px) {
    :global(html[data-reel]:not([data-reel='house'])) .workflow-preview {
      width: 88%;
      margin-inline: 6%;
    }
  }
</style>

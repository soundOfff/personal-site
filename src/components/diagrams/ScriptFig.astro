---
/**
 * Blog diagram: the tested-answers file as a play script, with the one
 * amber line you get to improvise. Token classes from global.css.
 */
---

<figure class="diagram">
  <svg
    viewBox="0 0 560 220"
    role="img"
    aria-label="A document titled answers.md with several ruled lines of text. One line is highlighted in amber and labeled improvise here."
  >
    <rect class="d-box" x="170" y="16" width="220" height="188" rx="10"></rect>
    <text class="d-num" x="190" y="44">answers.md</text>
    <rect class="d-bar" x="190" y="54" width="180" height="1.5"></rect>
    <rect class="d-bar" x="190" y="72" width="150" height="7" rx="3.5"></rect>
    <rect class="d-bar" x="190" y="92" width="120" height="7" rx="3.5"></rect>
    <rect class="d-accent-fill" x="190" y="112" width="160" height="7" rx="3.5"></rect>
    <rect class="d-bar" x="190" y="132" width="100" height="7" rx="3.5"></rect>
    <rect class="d-bar" x="190" y="152" width="140" height="7" rx="3.5"></rect>
    <rect class="d-bar" x="190" y="172" width="70" height="7" rx="3.5"></rect>
    <text class="d-note" x="148" y="81" text-anchor="end">tested answers</text>
    <line class="d-line" x1="152" y1="78" x2="186" y2="76"></line>
    <line class="d-accent" x1="354" y1="116" x2="400" y2="116"></line>
    <text class="d-accent-text" x="404" y="120">improvise here</text>
  </svg>
  <figcaption>
    The script: answers you have tested out loud, and the line you are allowed to improvise.
  </figcaption>
</figure>

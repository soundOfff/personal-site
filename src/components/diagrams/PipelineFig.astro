---
/**
 * Blog diagram: the generic interview pipeline, with the staff-augmentation
 * client interview as a dashed bonus stage. Styled entirely via the
 * `.diagram` token classes in global.css so it follows light/dark.
 */
---

<figure class="diagram">
  <svg
    viewBox="0 0 560 372"
    role="img"
    aria-label="The interview pipeline as a flowchart: HR screen, technical interview, system design, then manager or CEO, plus a dashed bonus stage, the client interview, at staff-augmentation consultancies. Behavioural questions live inside the HR screen and the final meeting."
  >
    <rect class="d-box" x="40" y="16" width="300" height="44" rx="8"></rect>
    <text class="d-num" x="60" y="43">01</text>
    <text class="d-label" x="88" y="44">HR screen</text>
    <circle class="d-accent-head" cx="356" cy="38" r="3"></circle>
    <text class="d-accent-text" x="366" y="42">behavioural, act I</text>
    <line class="d-line" x1="190" y1="64" x2="190" y2="84"></line>
    <polygon class="d-head" points="185,84 195,84 190,90"></polygon>
    <rect class="d-box" x="40" y="92" width="300" height="44" rx="8"></rect>
    <text class="d-num" x="60" y="119">02</text>
    <text class="d-label" x="88" y="120">Technical interview</text>
    <text class="d-note" x="356" y="118">async or sync</text>
    <line class="d-line" x1="190" y1="140" x2="190" y2="160"></line>
    <polygon class="d-head" points="185,160 195,160 190,166"></polygon>
    <rect class="d-box" x="40" y="168" width="300" height="44" rx="8"></rect>
    <text class="d-num" x="60" y="195">03</text>
    <text class="d-label" x="88" y="196">System design</text>
    <text class="d-note" x="356" y="188">often folded into 04</text>
    <text class="d-note" x="356" y="202">outside big tech</text>
    <line class="d-line" x1="190" y1="216" x2="190" y2="236"></line>
    <polygon class="d-head" points="185,236 195,236 190,242"></polygon>
    <rect class="d-box" x="40" y="244" width="300" height="44" rx="8"></rect>
    <text class="d-num" x="60" y="271">04</text>
    <text class="d-label" x="88" y="272">Manager / founder / CEO</text>
    <circle class="d-accent-head" cx="356" cy="266" r="3"></circle>
    <text class="d-accent-text" x="366" y="270">behavioural, encore</text>
    <line class="d-line" x1="190" y1="292" x2="190" y2="312" stroke-dasharray="4 4"></line>
    <polygon class="d-head" points="185,312 195,312 190,318"></polygon>
    <rect class="d-box" x="40" y="322" width="300" height="44" rx="8" stroke-dasharray="4 4"></rect>
    <text class="d-num" x="60" y="349">05</text>
    <text class="d-label" x="88" y="350">Client interview</text>
    <text class="d-note" x="356" y="348">staff-aug bonus level</text>
  </svg>
  <figcaption>The pipeline. Dashed = the consultancy bonus level.</figcaption>
</figure>

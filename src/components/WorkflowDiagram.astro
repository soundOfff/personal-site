---
import type { Workflow } from '../data/workflow';

interface Props {
  workflow: Workflow;
}

const { workflow } = Astro.props;
---

<figure class="workflow" aria-labelledby="workflow-title" data-workflow>
  <figcaption class="workflow-caption">
    <h2 id="workflow-title">{workflow.title}</h2>
    <p class="workflow-intro">{workflow.introduction}</p>
  </figcaption>
  <p class="workflow-instruction">Select a stage to see the work, the tools and my decision.</p>
  <div class="workflow-body">
    <div class="workflow-graph">
      <div class="workflow-edges" aria-hidden="true">
        <span class="workflow-edge workflow-edge--frame-design"></span>
        <span class="workflow-edge workflow-edge--design-build"></span>
        <span class="workflow-edge workflow-edge--build-review"></span>
        <span class="workflow-edge workflow-edge--review-decide"></span>
        <span class="workflow-edge workflow-edge--return-build"></span>
        <span class="workflow-return-design">
          <span class="workflow-return-design-start"></span>
          <span class="workflow-return-design-rise"></span>
          <span class="workflow-return-design-across"></span>
          <span class="workflow-edge workflow-return-design-end"></span>
        </span>
      </div>
      <ol class="workflow-stages">
        {
          workflow.stages.map((stage, index) => (
            <li class:list={['workflow-stage', `workflow-stage--${stage.id}`]}>
              <a
                class="workflow-stage-link"
                href={`#workflow-${stage.id}`}
                data-workflow-stage={stage.id}
              >
                <p class="workflow-owner">{stage.owner}</p>
                <h3>
                  <span class="workflow-number" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  {stage.label}
                </h3>
                <p class="workflow-hint">{stage.hint}</p>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="workflow-feedback-key">
        <p>
          Checks fail <span aria-hidden="true">→</span><span class="sr-only">return to</span> Build
        </p>
        <p>
          Approach fails <span aria-hidden="true">→</span><span class="sr-only">return to</span> Design
        </p>
      </div>
    </div>
    <div class="workflow-inspector">
      {
        workflow.stages.map((stage, index) => {
          const previous = workflow.stages[index - 1];
          const next = workflow.stages[index + 1];
          return (
            <section
              class="workflow-detail"
              id={`workflow-${stage.id}`}
              aria-labelledby={`workflow-${stage.id}-title`}
              tabindex="-1"
              data-workflow-panel={stage.id}
            >
              <p class="workflow-detail-meta">
                {String(index + 1).padStart(2, '0')} /{' '}
                {String(workflow.stages.length).padStart(2, '0')} · {stage.owner}
              </p>
              <h3 id={`workflow-${stage.id}-title`}>{stage.title}</h3>
              <p class="workflow-detail-intro">{stage.body}</p>
              <dl class="workflow-handoff">
                <div>
                  <>
                    <dt>Input</dt>
                    <dd>{stage.input}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>The work</dt>
                    <dd>{stage.action}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>Output</dt>
                    <dd>{stage.output}</dd>
                  </>
                </div>
                <div class="workflow-decision">
                  <>
                    <dt>My decision</dt>
                    <dd>{stage.humanDecision}</dd>
                  </>
                </div>
              </dl>
              {stage.skillGroups.length > 0 && (
                <div class="workflow-skills">
                  <h4>Skills I use here</h4>
                  {stage.skillGroups.map((group) => (
                    <div class="workflow-skill-group">
                      <p class="workflow-skill-source">{group.source}</p>
                      <ul>
                        {group.skills.map((skill) => (
                          <li>
                            <code>{skill.name}</code>
                            <span>{skill.purpose}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              )}
              {stage.condition && (
                <p class="workflow-condition">
                  <strong>{stage.condition.label}</strong>
                  {stage.condition.body}
                </p>
              )}
              {stage.id === workflow.feedback.from && (
                <p class="workflow-condition">
                  <strong>{workflow.feedback.label}</strong>
                  {workflow.feedback.body}
                </p>
              )}
              <nav class="workflow-stage-navigation" aria-label="Explore workflow stages">
                {previous && (
                  <a href={`#workflow-${previous.id}`} data-workflow-stage={previous.id}>
                    ← {previous.label}
                  </a>
                )}
                {next && (
                  <a href={`#workflow-${next.id}`} data-workflow-stage={next.id}>
                    {next.label} →
                  </a>
                )}
              </nav>
            </section>
          );
        })
      }
    </div>
  </div>
  <p class="workflow-sources">
    <span>The skill collections</span>
    {workflow.sources.map((source) => <a href={source.href}>{source.label}</a>)}
  </p>
</figure>

<style>
  .workflow {
    --workflow-node-height: 100px;
    --workflow-row-gap: 32px;
    --workflow-gutter: max(32px, 12%);
    --workflow-column: calc((100% - var(--workflow-gutter)) / 2);
    container-type: inline-size;
    margin: 0;
    color: var(--ink);
    text-align: left;
  }
  .workflow-caption {
    margin-bottom: 18px;
  }
  .workflow h2 {
    margin: 0;
    font: 500 clamp(25px, 3.5vw, 32px) / 1.12 var(--font-serif);
    letter-spacing: -0.025em;
    text-transform: none;
    color: var(--ink);
  }
  .workflow-intro {
    max-width: 62ch;
    margin: 10px 0 0;
    font: 400 14px/1.5 var(--font-sans);
    color: var(--ink-2);
  }
  .workflow-graph {
    position: relative;
    max-width: 640px;
    height: calc(3 * var(--workflow-node-height) + 2 * var(--workflow-row-gap));
  }
  .workflow-stages {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(3, var(--workflow-node-height));
    gap: var(--workflow-row-gap) var(--workflow-gutter);
    list-style: decimal;
    margin: 0;
    padding: 0;
  }
  .workflow-stage {
    box-sizing: border-box;
    min-width: 0;
    padding: 0;
    border: 1px solid var(--amber-deep);
    background: var(--paper);
  }
  .workflow-stage::marker {
    font-size: 0;
  }
  .workflow-stage--frame,
  .workflow-stage--decide {
    border-color: var(--ink);
  }
  .workflow-stage--frame {
    grid-area: 1 / 1;
  }
  .workflow-stage--design {
    grid-area: 1 / 2;
  }
  .workflow-stage--build {
    grid-area: 2 / 2;
  }
  .workflow-stage--verify {
    grid-area: 2 / 1;
  }
  .workflow-stage--decide {
    grid-area: 3 / 1;
  }
  .workflow-owner {
    margin: 0 0 5px;
    color: var(--amber-deep);
    font: 500 12px/1.2 var(--font-sans);
  }
  .workflow-stage--frame .workflow-owner,
  .workflow-stage--decide .workflow-owner {
    color: var(--ink);
  }
  .workflow h3 {
    display: flex;
    align-items: baseline;
    gap: 7px;
    margin: 0;
    color: var(--ink);
    font: 500 23px/1.15 var(--font-serif);
    letter-spacing: -0.015em;
    text-transform: none;
  }
  .workflow-number {
    color: var(--ink-2);
    font: 400 10px/1 var(--font-mono);
    letter-spacing: 0;
  }
  .workflow-hint {
    margin: 5px 0 0;
    color: var(--ink-2);
    font: 400 13px/1.35 var(--font-sans);
  }
  .workflow-edges {
    position: absolute;
    inset: 0;
    color: var(--ink-2);
    pointer-events: none;
  }
  .workflow-edge {
    position: absolute;
    box-sizing: border-box;
  }
  .workflow-edge::after {
    content: '';
    position: absolute;
    width: 5px;
    height: 5px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
  }
  .workflow-edge--frame-design,
  .workflow-edge--build-review,
  .workflow-edge--return-build {
    left: var(--workflow-column);
    width: var(--workflow-gutter);
    border-top: 1px solid currentColor;
  }
  .workflow-edge--frame-design {
    top: calc(var(--workflow-node-height) / 2);
  }
  .workflow-edge--frame-design::after,
  .workflow-edge--return-build::after {
    top: -3px;
    right: 1px;
    transform: rotate(45deg);
  }
  .workflow-edge--design-build,
  .workflow-edge--review-decide {
    height: var(--workflow-row-gap);
    border-left: 1px solid currentColor;
  }
  .workflow-edge--design-build {
    top: var(--workflow-node-height);
    left: calc(100% - var(--workflow-column) / 2);
  }
  .workflow-edge--review-decide {
    top: calc(2 * var(--workflow-node-height) + var(--workflow-row-gap));
    left: calc(var(--workflow-column) / 2);
  }
  .workflow-edge--design-build::after,
  .workflow-edge--review-decide::after {
    bottom: 1px;
    left: -3px;
    transform: rotate(135deg);
  }
  .workflow-edge--build-review {
    top: calc(1.5 * var(--workflow-node-height) + var(--workflow-row-gap));
  }
  .workflow-edge--build-review::after {
    top: -3px;
    left: 1px;
    transform: rotate(225deg);
  }
  .workflow-edge--return-build {
    top: calc(1.8 * var(--workflow-node-height) + var(--workflow-row-gap));
    border-top-style: dashed;
    color: var(--amber-deep);
  }
  .workflow-return-design {
    color: var(--amber-deep);
  }
  .workflow-return-design > span {
    position: absolute;
    box-sizing: border-box;
  }
  .workflow-return-design-start {
    top: calc(1.2 * var(--workflow-node-height) + var(--workflow-row-gap));
    left: var(--workflow-column);
    width: calc(var(--workflow-gutter) / 2);
    border-top: 1px dashed currentColor;
  }
  .workflow-return-design-rise {
    top: calc(var(--workflow-node-height) + var(--workflow-row-gap) / 2);
    left: 50%;
    height: calc(0.2 * var(--workflow-node-height) + var(--workflow-row-gap) / 2);
    border-left: 1px dashed currentColor;
  }
  .workflow-return-design-across {
    top: calc(var(--workflow-node-height) + var(--workflow-row-gap) / 2);
    left: 50%;
    width: calc(var(--workflow-gutter) / 2 + var(--workflow-column) / 4);
    border-top: 1px dashed currentColor;
  }
  .workflow-return-design-end {
    top: var(--workflow-node-height);
    left: calc(100% - 0.75 * var(--workflow-column));
    height: calc(var(--workflow-row-gap) / 2);
    border-left: 1px dashed currentColor;
  }
  .workflow-return-design-end::after {
    top: 1px;
    left: -3px;
    transform: rotate(-45deg);
  }
  .workflow-feedback-key {
    position: absolute;
    top: calc(2 * (var(--workflow-node-height) + var(--workflow-row-gap)));
    right: 0;
    display: grid;
    align-content: center;
    gap: 9px;
    width: var(--workflow-column);
    height: var(--workflow-node-height);
    color: var(--ink-2);
    font: 400 12px/1.4 var(--font-sans);
  }
  .workflow-feedback-key p {
    margin: 0;
    padding-left: 8px;
    border-left: 1px dashed var(--amber-deep);
  }
  .workflow-instruction {
    margin: 0 0 18px;
    color: var(--ink-2);
    font: 400 12px/1.5 var(--font-sans);
  }
  .workflow-body {
    display: grid;
    align-items: start;
    gap: 26px;
    min-width: 0;
  }
  .workflow-stage-link {
    display: block;
    height: 100%;
    padding: 12px 14px;
    color: inherit;
    text-decoration: none;
    transition: background 120ms;
  }
  .workflow-stage-link:hover {
    background: var(--paper-2);
  }
  .workflow-stage-link[aria-current='step'] {
    background: var(--paper-2);
    box-shadow: inset 3px 0 0 var(--amber-deep);
  }
  .workflow-stage-link:focus-visible,
  .workflow-stage-navigation a:focus-visible,
  .workflow-sources a:focus-visible {
    outline: 2px solid var(--amber-deep);
    outline-offset: 4px;
  }
  .workflow-inspector {
    min-width: 0;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
    font: 400 14px/1.6 var(--font-sans);
  }
  .workflow-detail {
    scroll-margin-top: 100px;
  }
  .workflow-detail + .workflow-detail {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .workflow[data-enhanced] .workflow-detail {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .workflow-detail-meta {
    margin: 0 0 8px;
    color: var(--amber-deep);
    font: 400 10px/1.5 var(--font-mono);
  }
  .workflow-detail h3 {
    display: block;
    margin: 0;
    font: 500 27px/1.15 var(--font-serif);
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .workflow-detail-intro {
    margin: 10px 0 18px;
  }
  .workflow-handoff {
    display: grid;
    gap: 14px;
    margin: 0;
  }
  .workflow-handoff dt {
    margin-bottom: 3px;
    color: var(--ink);
    font: 500 10px/1.5 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .workflow-handoff dd {
    margin: 0;
  }
  .workflow-decision {
    padding-left: 12px;
    border-left: 2px solid var(--amber-deep);
  }
  .workflow-decision dd {
    color: var(--ink);
  }
  .workflow-skills {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  .workflow-skills h4 {
    margin: 0 0 10px;
    color: var(--ink);
    font: 500 16px/1.3 var(--font-serif);
    text-transform: none;
  }
  .workflow-skill-group + .workflow-skill-group {
    margin-top: 12px;
  }
  .workflow-skill-source {
    margin: 0 0 5px;
    font: 500 10px/1.5 var(--font-mono);
    color: var(--ink);
  }
  .workflow-skills ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .workflow-skills li {
    display: grid;
    gap: 2px;
    font-size: 12px;
  }
  .workflow-skills code {
    width: fit-content;
    overflow-wrap: anywhere;
    color: var(--ink);
    font: 400 11px/1.5 var(--font-mono);
  }
  .workflow-condition {
    margin: 18px 0 0;
    font-size: 12px;
  }
  .workflow-condition strong {
    display: block;
    font-weight: 500;
    color: var(--ink);
  }
  .workflow-stage-navigation {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 20px;
    border-top: 1px solid var(--rule);
  }
  .workflow-stage-navigation a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-underline-offset: 4px;
  }
  .workflow-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 24px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
    font: 400 12px/1.5 var(--font-sans);
  }
  .workflow-sources a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  @container (min-width: 820px) {
    .workflow-body {
      grid-template-columns: minmax(360px, 1fr) minmax(340px, 1fr);
      gap: 36px;
    }
    .workflow-inspector {
      padding: 0 0 0 26px;
      border-top: 0;
      border-left: 1px solid var(--rule);
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .workflow-stage-link {
      padding: 10px;
    }
    .workflow h3 {
      gap: 5px;
      font-size: 21px;
    }
    .workflow-hint {
      font-size: 12px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-workflow]').forEach((workflow) => {
    const links = [...workflow.querySelectorAll<HTMLAnchorElement>('[data-workflow-stage]')];
    const panels = [...workflow.querySelectorAll<HTMLElement>('[data-workflow-panel]')];
    const firstPanel = panels[0];
    if (!firstPanel) return;

    function selectPanel(selected: HTMLElement) {
      panels.forEach((panel) => {
        panel.hidden = panel !== selected;
      });
      links.forEach((link) => {
        if (link.hash === `#${selected.id}`) link.setAttribute('aria-current', 'step');
        else link.removeAttribute('aria-current');
      });
    }

    function panelFromHash() {
      return panels.find((panel) => `#${panel.id}` === window.location.hash);
    }

    selectPanel(panelFromHash() ?? firstPanel);
    workflow.dataset.enhanced = '';

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        const panel = panels.find((candidate) => `#${candidate.id}` === link.hash);
        if (panel) selectPanel(panel);
      });
    });

    window.addEventListener('hashchange', () => {
      selectPanel(panelFromHash() ?? firstPanel);
    });
  });
</script>

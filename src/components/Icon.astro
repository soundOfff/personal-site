---
// Thin wrapper over the icon sprite (src/assets/icons.svg, inlined by BaseLayout).
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 16, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <use href={`#${name}`}></use>
</svg>

---
import type { Project } from '../data/projects';
interface Props {
  project: Project;
}
const { project: p } = Astro.props;
---

<figure class:list={['product-preview', `preview-${p.id}`, { 'real-preview': p.image }]}>
  {
    p.image ? (
      <img
        src={p.image}
        alt={`${p.name} project preview`}
        loading="lazy"
        width="1440"
        height="900"
      />
    ) : (
      <div class="preview-stage" aria-hidden="true">
        {p.id === 'mint' && (
          <div class="mint-store">
            <div class="mini-nav">
              <b>mint mobile</b>
              <span>Plans & phones</span>
            </div>
            <div class="mint-content">
              <div>
                <small>Wireless, simplified.</small>
                <strong>
                  A fresh take
                  <br />
                  on mobile.
                </strong>
                <span class="mint-button">Find your plan</span>
              </div>
              <div class="mint-plans">
                <div>
                  <small>Made for you</small>
                  <b>Unlimited</b>
                  <span>Talk. Text. Data.</span>
                </div>
                <div class="mint-phone">
                  <i />
                  <b>mint</b>
                </div>
              </div>
            </div>
          </div>
        )}
        {p.id === 'dex' && (
          <div class="dex-app">
            <aside>
              <b>dex</b>
              <span>Overview</span>
              <span>People</span>
              <span>Reminders</span>
              <span>Notes</span>
            </aside>
            <div class="dex-main">
              <small>Your relationships, thoughtfully kept.</small>
              <h4>Stay in touch</h4>
              <div class="person">
                <i>JL</i>
                <div>
                  <b>Jamie Lee</b>
                  <span>Coffee next week</span>
                </div>
                <em>Today</em>
              </div>
              <div class="person">
                <i>AC</i>
                <div>
                  <b>Alex Chen</b>
                  <span>Catch up on the new role</span>
                </div>
                <em>Tomorrow</em>
              </div>
              <div class="dex-note">
                A little context goes a long way.
                <span>Notes, reminders and the people behind them.</span>
              </div>
            </div>
          </div>
        )}
        {p.id === 'second-brain' && (
          <div class="wiki">
            <aside>
              <b>Second Brain</b>
              <span>Inbox</span>
              <span>Sources</span>
              <span>Concepts</span>
              <span>Reading queue</span>
            </aside>
            <div>
              <small>Concepts / Learning</small>
              <h4>Knowledge that connects.</h4>
              <p>A living wiki of ideas, evidence and the relationships between them.</p>
              <div class="wiki-links">
                <span>Spaced repetition</span>
                <span>Mental models</span>
                <span>Active recall</span>
              </div>
            </div>
          </div>
        )}
        {p.id === 'catcher' && (
          <div class="catcher">
            <div class="mini-nav">
              <b>Catcher</b>
              <span>My collection</span>
            </div>
            <h4>Good interfaces, kept close.</h4>
            <div class="capture-grid">
              <div>
                <span class="sample-button">Continue</span>
                <small>Buttons</small>
              </div>
              <div>
                <span class="sample-avatar">TB</span>
                <small>Profiles</small>
              </div>
              <div>
                <span class="sample-bars">
                  <i />
                  <i />
                  <i />
                </span>
                <small>Navigation</small>
              </div>
            </div>
          </div>
        )}
        {p.id === 'on-call' && (
          <div class="oncall">
            <div class="mini-nav">
              <b>On-Call</b>
              <span class="health">Systems monitored</span>
            </div>
            <h4>Incident timeline</h4>
            <div class="event">
              <time>14:32</time>
              <b>Elevated API latency</b>
              <span>Investigating</span>
            </div>
            <div class="event">
              <time>14:35</time>
              <b>Primary responder notified</b>
              <span>Acknowledged</span>
            </div>
            <div class="event">
              <time>14:41</time>
              <b>Service recovered</b>
              <span>Resolved</span>
            </div>
          </div>
        )}
        {p.id === 'curation' && (
          <div class="curation">
            <div class="mini-nav">
              <b>Curation Archive</b>
              <span>Objects worth keeping</span>
            </div>
            <div class="archive-art">
              <div>
                <i />
              </div>
              <div>
                <i />
              </div>
              <div>
                <i />
              </div>
            </div>
            <small>Form studies / Personal collection / Visual search</small>
          </div>
        )}
        {p.id === 'editorial' && (
          <div class="editorial">
            <small>Editorial UI / Component library</small>
            <h4>Space for the story.</h4>
            <div class="type-specimen">
              <span>Aa</span>
              <div>
                <b>Thoughtful defaults.</b>
                <p>
                  Type, rhythm and components
                  <br />
                  for content-first interfaces.
                </p>
                <span class="swatches">
                  <i />
                  <i />
                  <i />
                  <i />
                </span>
              </div>
            </div>
          </div>
        )}
        {p.id === 'dana' && (
          <div class="dana">
            <div class="mini-nav">
              <b>dana</b>
              <span>Your next conversation</span>
            </div>
            <h4>Walk in prepared.</h4>
            <div class="meeting">
              <span>10:00 / Product sync</span>
              <b>Your meeting brief</b>
              <p>
                Context from the conversations,
                <br />
                decisions and documents that matter.
              </p>
              <div>
                <span>Calendar</span>
                <span>Email</span>
                <span>Slack</span>
              </div>
            </div>
          </div>
        )}
        {p.id === '60-seconds' && (
          <div class="prompt-game">
            <div class="mini-nav">
              <b>60 Seconds to Prompt</b>
              <strong>00:60</strong>
            </div>
            <h4>One brief. Your interpretation.</h4>
            <div class="prompt-box">
              Create a reading dashboard with a quiet,
              <br />
              focused layout.<span>Compose your prompt…</span>
            </div>
            <small>Design / Build / Get feedback</small>
          </div>
        )}
        {p.id === 'letterboxd' && (
          <div class="story">
            <div class="book">
              <small>A year in films</small>
              <h4>
                The stories
                <br />
                that stayed.
              </h4>
              <div class="film-scene">
                <i />
                <i />
                <i />
              </div>
              <span>A diary, reimagined.</span>
            </div>
            <div class="book-page">
              <small>Chapter one</small>
              <p>
                Every film leaves
                <br />a little of its
                <br />
                world behind.
              </p>
              <span>From your Letterboxd diary</span>
            </div>
          </div>
        )}
        {p.id === 'a2ui' && (
          <div class="conversation">
            <div class="mini-nav">
              <b>Ask about my work</b>
              <span>A2UI</span>
            </div>
            <div class="question">What have you built with AI?</div>
            <div class="answer">
              <b>From context to useful products.</b>
              <div>
                <span>Meeting preparation</span>
                <span>Learning tools</span>
                <span>Multi-model routing</span>
              </div>
            </div>
            <small>A conversation that becomes an interface.</small>
          </div>
        )}
      </div>
    )
  }
  <figcaption>{p.image ? 'Product screenshot' : 'Representative UI study'}</figcaption>
</figure>
<style>
  .product-preview {
    margin: 0;
    position: relative;
    height: 300px;
    overflow: hidden;
    border-radius: 12px;
    background: #e9edf4;
    color: #233047;
    font: 12px/1.5 var(--font-sans);
  }
  .preview-stage {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px;
  }
  figcaption {
    position: absolute;
    bottom: 9px;
    left: 14px;
    font-size: 9px;
    color: #526075;
    background: #ffffffd9;
    border-radius: 3px;
    padding: 2px 6px;
  }
  .product-preview img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 18px;
  }
  .preview-stage > div {
    width: 100%;
  }
  h4,
  p {
    margin: 0;
  }
  h4 {
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }
  small {
    font-size: 10px;
  }
  .mini-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 24px;
  }
  .mini-nav > b {
    font-size: 15px;
    letter-spacing: -0.04em;
  }
  .mini-nav > span {
    font-size: 9px;
  }
  .preview-mint {
    background: #e7f1ea;
  }
  .mint-store {
    color: #405d46;
  }
  .mint-store .mini-nav > b {
    font-size: 24px;
    font-weight: 850;
    letter-spacing: -0.06em;
  }
  .mint-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .mint-content strong {
    display: block;
    font-size: 34px;
    line-height: 0.99;
    letter-spacing: -0.06em;
    margin: 10px 0 18px;
    font-weight: 850;
  }
  .mint-button {
    background: #df6d40;
    color: #fff;
    border-radius: 20px;
    padding: 8px 15px;
    font-size: 10px;
    font-weight: 600;
  }
  .mint-plans {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .mint-plans > div:first-child {
    background: #fff;
    border-radius: 10px;
    padding: 16px 12px;
    display: grid;
    gap: 8px;
  }
  .mint-plans b {
    font-size: 16px;
  }
  .mint-plans span {
    font-size: 9px;
  }
  .mint-phone {
    border: 5px solid #405d46;
    border-radius: 18px;
    height: 150px;
    width: 75px;
    display: grid;
    place-content: center;
    background: #82a38b;
    color: #fff;
    transform: rotate(8deg);
  }
  .mint-phone i {
    position: absolute;
    top: 8px;
    left: 24px;
    width: 22px;
    height: 5px;
    background: #405d46;
    border-radius: 9px;
  }
  .preview-dex {
    background: #eae5f8;
  }
  .dex-app,
  .wiki {
    display: grid;
    grid-template-columns: 100px 1fr;
    min-height: 220px;
    border: 1px solid #ddd7e8;
    border-radius: 8px;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 8px 20px #32265009;
  }
  aside {
    display: flex;
    flex-direction: column;
    gap: 13px;
    padding: 18px 12px;
    background: #f4f1fa;
    font-size: 9px;
  }
  aside > b {
    font-size: 22px;
    color: #7854ad;
    margin-bottom: 6px;
  }
  .dex-main {
    padding: 20px 16px;
  }
  .dex-main h4 {
    margin: 6px 0 18px;
    font-size: 22px;
  }
  .dex-main > small {
    font-size: 8px;
    color: #777;
  }
  .person {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 0;
    border-top: 1px solid #eee;
  }
  .person i {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #e8def3;
    font-size: 9px;
    font-style: normal;
  }
  .person div {
    flex: 1;
  }
  .person b,
  .person span {
    display: block;
    font-size: 9px;
  }
  .person span {
    font-size: 8px;
    color: #777;
  }
  .person em {
    font-size: 8px;
    font-style: normal;
    color: #8158b3;
  }
  .dex-note {
    font-size: 9px;
    background: #f7f3fc;
    padding: 9px;
    margin-top: 8px;
    border-radius: 5px;
  }
  .dex-note span {
    display: block;
    font-size: 8px;
    color: #777;
  }
  .preview-sift {
    background: #e5eaf4;
  }
  .preview-focus-quote {
    background: #eee9de;
  }
  .wiki {
    grid-template-columns: 100px 1fr;
    border-color: #dce2e6;
  }
  .wiki aside {
    background: #eef2f4;
  }
  .wiki aside > b {
    font-size: 12px;
    color: #244b58;
  }
  .wiki > div {
    padding: 22px 18px;
  }
  .wiki h4 {
    font-family: var(--font-serif);
    font-size: 27px;
    margin: 16px 0 12px;
  }
  .wiki p {
    font-size: 10px;
    color: #64717b;
  }
  .wiki-links {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 15px;
  }
  .wiki-links span {
    font-size: 8px;
    background: #edf1f5;
    border-radius: 4px;
    padding: 4px;
  }
  .preview-catcher {
    background: #ffe9db;
  }
  .catcher {
    background: #fff8f1;
    border-radius: 9px;
    padding: 20px;
  }
  .catcher h4 {
    font-size: 21px;
  }
  .capture-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 20px;
  }
  .capture-grid > div {
    height: 95px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 13px;
    border: 1px solid #f0ddd0;
    border-radius: 7px;
  }
  .capture-grid small {
    font-size: 8px;
    color: #8b6e5d;
  }
  .sample-button {
    background: #e66e3f;
    color: #fff;
    padding: 7px 10px;
    border-radius: 5px;
    font-size: 8px;
  }
  .sample-avatar {
    border-radius: 50%;
    padding: 9px;
    background: #efd3c5;
  }
  .sample-bars {
    display: grid;
    gap: 4px;
    width: 35px;
  }
  .sample-bars i {
    height: 4px;
    background: #d3bcae;
    border-radius: 2px;
  }
  .preview-on-call {
    background: #e6edf1;
  }
  .oncall {
    background: #172631;
    padding: 22px;
    color: #eef4f7;
    border-radius: 8px;
  }
  .health {
    color: #a4d8ba;
  }
  .oncall h4 {
    font-size: 20px;
    margin-bottom: 18px;
  }
  .event {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px 0;
    border-top: 1px solid #35424b;
    font-size: 8px;
  }
  .event time {
    color: #93a9b6;
  }
  .event b {
    flex: 1;
    font-weight: 400;
  }
  .event span {
    color: #a4d8ba;
    font-size: 7px;
  }
  .preview-curation {
    background: #f1ecef;
  }
  .curation {
    padding: 8px;
  }
  .archive-art {
    display: flex;
    gap: 10px;
    height: 145px;
    margin-bottom: 14px;
  }
  .archive-art > div {
    flex: 1;
    background: #c5cbd5;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .archive-art > div:nth-child(2) {
    background: #d6a68f;
  }
  .archive-art > div:nth-child(3) {
    background: #959f88;
  }
  .archive-art i {
    display: block;
    background: #f6f1e5;
    width: 65px;
    height: 90px;
    border-radius: 50% 50% 5% 5%;
    transform: rotate(-20deg);
    box-shadow: 15px 18px 0 #0002;
  }
  .archive-art > div:nth-child(2) i {
    border-radius: 50%;
    width: 80px;
    height: 80px;
    background: #4b4a58;
    transform: translateY(35px);
  }
  .archive-art > div:nth-child(3) i {
    border-radius: 0;
    transform: rotate(25deg);
    background: #e9d5a9;
  }
  .curation > small {
    font-size: 8px;
  }
  .preview-editorial {
    background: #eee8dc;
  }
  .editorial {
    padding: 12px;
    color: #39392e;
  }
  .editorial h4 {
    font: 38px/1.1 var(--font-serif);
    margin: 16px 0;
  }
  .type-specimen {
    display: flex;
    gap: 26px;
    align-items: center;
  }
  .type-specimen > span {
    font: 80px/1 var(--font-serif);
  }
  .type-specimen b {
    font-size: 11px;
  }
  .type-specimen p {
    font-size: 9px;
    margin: 6px 0;
  }
  .swatches {
    display: flex;
    gap: 5px;
  }
  .swatches i {
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: #3a493d;
  }
  .swatches i:nth-child(2) {
    background: #a5ad94;
  }
  .swatches i:nth-child(3) {
    background: #d5c2a7;
  }
  .swatches i:nth-child(4) {
    background: #fff;
  }
  .preview-dana {
    background: #dceceb;
  }
  .dana {
    padding: 4px 16px;
    color: #27504b;
  }
  .dana .mini-nav > b {
    font-size: 22px;
  }
  .dana h4 {
    margin-bottom: 18px;
    font-size: 27px;
  }
  .meeting {
    background: #fff;
    padding: 17px;
    border-radius: 9px;
    box-shadow: 0 4px 14px #27504b09;
  }
  .meeting > span {
    font-size: 8px;
    color: #778783;
  }
  .meeting > b {
    display: block;
    font-size: 13px;
    margin: 7px 0;
  }
  .meeting p {
    font-size: 10px;
    color: #667773;
  }
  .meeting > div {
    display: flex;
    gap: 8px;
    margin-top: 13px;
  }
  .meeting > div span {
    padding: 3px 7px;
    background: #edf4f2;
    border-radius: 4px;
    font-size: 8px;
  }
  .preview-60-seconds {
    background: #e7e9fc;
  }
  .prompt-game {
    background: #fafaff;
    border: 1px solid #ccd0ee;
    border-radius: 9px;
    padding: 20px;
  }
  .prompt-game .mini-nav strong {
    background: #dedffa;
    color: #5551ad;
    padding: 5px 8px;
    border-radius: 4px;
  }
  .prompt-game h4 {
    font-size: 20px;
    margin: 12px 0;
  }
  .prompt-box {
    padding: 12px;
    background: #fff;
    border: 1px solid #dedeee;
    border-radius: 6px;
    font-size: 10px;
  }
  .prompt-box span {
    display: block;
    color: #86869e;
    margin-top: 16px;
  }
  .prompt-game > small {
    display: block;
    margin-top: 14px;
    font-size: 8px;
    color: #77768c;
  }
  .preview-letterboxd {
    background: #d7e1dc;
  }
  .story {
    display: flex;
    justify-content: center;
    max-width: 320px;
    filter: drop-shadow(0 8px 10px #1a392d19);
  }
  .book,
  .book-page {
    width: 50%;
    min-height: 225px;
    padding: 18px;
    background: #23483e;
    color: #edf1dd;
  }
  .book {
    border-radius: 3px 0 0 3px;
  }
  .book h4 {
    font: 26px/1 var(--font-serif);
    margin: 16px 0;
  }
  .book small,
  .book span {
    font-size: 8px;
  }
  .film-scene {
    display: flex;
    align-items: end;
    height: 60px;
    gap: 6px;
    margin-bottom: 12px;
  }
  .film-scene i {
    height: 36px;
    width: 25px;
    background: #dca67b;
    border-radius: 20px 20px 0 0;
  }
  .film-scene i:nth-child(2) {
    height: 55px;
    background: #b9cbb5;
  }
  .film-scene i:nth-child(3) {
    height: 44px;
    background: #e4d6aa;
  }
  .book-page {
    background: #f7f3e7;
    color: #365247;
    box-shadow: inset 6px 0 8px #0001;
  }
  .book-page p {
    font: 22px/1.3 var(--font-serif);
    margin-top: 34px;
  }
  .book-page > span {
    display: block;
    font-size: 7px;
    margin-top: 30px;
  }
  .preview-a2ui {
    background: #e4ebfb;
  }
  .conversation {
    padding: 20px;
    background: #fff;
    border-radius: 10px;
  }
  .question {
    margin-left: 40px;
    padding: 10px;
    background: #eaf0fc;
    border-radius: 9px;
    font-size: 10px;
  }
  .answer {
    padding: 16px 0;
  }
  .answer > b {
    font-size: 12px;
  }
  .answer > div {
    display: flex;
    gap: 5px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .answer span {
    border: 1px solid #dce3ee;
    padding: 7px;
    font-size: 8px;
    border-radius: 5px;
  }
  .conversation > small {
    color: #788396;
    font-size: 8px;
  }
  @media (max-width: 600px) {
    .product-preview {
      height: 260px;
    }
    .preview-stage {
      padding: 22px 18px;
    }
    .mint-content strong {
      font-size: 29px;
    }
    .mint-phone {
      display: none;
    }
    .dex-app,
    .wiki {
      grid-template-columns: 85px 1fr;
    }
    .dex-main {
      padding: 15px 12px;
    }
  }
</style>

---
import { profile, nav, contact, site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  /** which section id is the current page context (rarely used on homepage). */
  active?: string;
}
const { active } = Astro.props;
---

<aside class="rail">
  <div class="id">
    <span class="tile">{profile.monogram}</span>
    <div>
      <div class="nm">{profile.name}</div>
      <div class="rl">{profile.role}</div>
    </div>
  </div>

  <span class="status"><span class="pulse"></span>{profile.status}</span>

  <nav class="railnav" aria-label="Sections">
    {
      nav.map((item, i) => (
        <a href={`#${item.id}`} aria-current={active === item.id ? 'true' : undefined}>
          <span class="nx">{String(i).padStart(2, '0')}</span>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="contact-wrap">
    <div class="rail-sec">Contact</div>
    <div class="contact">
      {
        contact.map((c) => {
          const external = c.href.startsWith('http');
          // The CV PDF also opens in a new tab so the reader keeps their place.
          const newTab = external || c.href.endsWith('.pdf');
          return (
            <a
              href={c.href}
              target={newTab ? '_blank' : undefined}
              rel={newTab ? (external ? 'me noopener noreferrer' : 'noopener') : undefined}
            >
              <Icon name={c.icon} size={14} />
              {c.label}
            </a>
          );
        })
      }
    </div>
  </div>

  <div class="rail-foot">
    <span class="mono">{site.copyright}</span>
    <button class="btn-icon btn-quiet" data-theme-toggle aria-label="Toggle theme" type="button">
      <svg
        width="15"
        height="15"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
      >
        <use href="#i-moon" data-theme-icon></use>
      </svg>
    </button>
  </div>
</aside>

<!-- Scrollspy: highlight the rail item for the section nearest the top of the
     viewport. Recomputed on scroll rather than IntersectionObserver so short
     final sections still win when scrolled to the bottom. -->
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.railnav a[href^="#"]')];
  const sections = links
    .map((a) => document.getElementById(a.hash.slice(1)))
    .filter((s): s is HTMLElement => s !== null);

  if (links.length && sections.length) {
    const setActive = (id: string) => {
      links.forEach((a) => {
        if (a.hash.slice(1) === id) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      // At the very bottom, the last section is active even if it's short.
      if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 2) {
        setActive(sections[sections.length - 1].id);
        return;
      }
      const probe = window.scrollY + window.innerHeight * 0.3;
      let current = sections[0];
      for (const s of sections) {
        if (s.offsetTop <= probe) current = s;
      }
      setActive(current.id);
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

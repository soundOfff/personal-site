---
import PixelSigil from './PixelSigil.astro';

const path = Astro.url.pathname;
// proto/showcase: the prototype route behaves like home.
const home = path === '/' || path.startsWith('/prototype/');
// On the homepage the active section follows the scroll position instead.
const links = [
  { label: 'Work', href: '/#work', section: 'work' },
  { label: 'Index', href: '/#index', section: 'index' },
  { label: 'Journal', href: '/blog', active: path.startsWith('/blog') },
  { label: 'Contact', href: '#contact', section: 'contact' },
];
---

<header id="header">
  <a href="/" class="wordmark">Tomas Brasca</a>
  <a
    href="/"
    class="brand-star"
    aria-label={home ? 'Back to the top and replay the flood' : 'Home'}
    data-replay={home ? '' : undefined}><PixelSigil star /></a
  >
  <nav aria-label="Main navigation">
    {
      links.map((link) => (
        <a
          href={home && link.section ? `#${link.section}` : link.href}
          data-section={link.section}
          class:list={{ active: link.active }}
          aria-current={link.active ? 'page' : undefined}
        >
          <span aria-hidden="true">(</span> {link.label} <span aria-hidden="true">)</span>
        </a>
      ))
    }
  </nav>
  <a class="resume" href="/cv.pdf" target="_blank" rel="noopener">Résumé</a>
</header>

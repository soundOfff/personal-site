---
const fibers = Array.from({ length: 192 }, (_, i) => {
  const angle = (i * Math.PI * 2) / 192;
  const start = 112 + Math.sin(i * 7) * 14;
  const end = 306 + Math.cos(i * 11) * 18;
  const bend = angle + Math.sin(i * 4) * 0.018;
  const point = (a: number, r: number) =>
    `${(400 + Math.cos(a) * r).toFixed(1)} ${(400 + Math.sin(a) * r).toFixed(1)}`;
  return `M${point(angle, start)}Q${point(bend, 220)} ${point(angle, end)}`;
});
---

<div class="opening-scene opening-blade" data-opening="br2049">
  <div class="bk-macro">
    <div class="bk-copy">

---
const steps = Array.from({ length: 14 }, (_, i) => `M${365 + i * 14} ${468 + i * 17}h28v17`);
---

<div class="opening-scene opening-parasite" data-opening="parasite">
  <div class="ps-underground" aria-hidden="true"></div>
  <div class="ps-copy">
    <p class="shot-kicker">01 / Parasite</p>
    <h1>Apps<br /><em>and APIs.</em></h1>
    <p class="ps-note">Work at Dex<br />and Mint Mobile.</p>
  </div>
  <p class="ps-below" aria-hidden="true">Inventory<br />and checkout.</p>
  <div class="ps-drawing" aria-hidden="true">
    <svg viewBox="0 0 800 1100" fill="none">
      <defs>
        <pattern id="ps-lawn" width="12" height="14" patternUnits="userSpaceOnUse"
          ><path d="m2 10 2-4m5 6 1-3" stroke="#617457" stroke-width=".7"></path></pattern
        >
        <pattern id="ps-concrete" width="40" height="32" patternUnits="userSpaceOnUse"
          ><circle cx="4" cy="4" r="1" fill="#777b6c" opacity=".3"></circle></pattern
        >
      </defs>
      <path d="M68 74h660v408H68Z" fill="#d7d9ca"></path>

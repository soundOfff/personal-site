---
/**
 * The box office: the first visit. Five tickets, one paper stock per film,
 * plus House lights. Tear one: a countdown leader with the 2-pop, then the
 * engine's projector shows that reel's title card and opens on it.
 *
 * A closed <dialog>, so with no JS it is never shown and the site reads as
 * it is. The head bootstrap sets html[data-first-visit] for a fresh visitor:
 * boxoffice.css shows the lobby from the first frame on that attribute, and
 * boxoffice.ts upgrades it to a modal (showModal, Esc, focus).
 */
import { REELS, DEFAULT_REEL } from '../registry';
import { profile } from '../../data/site';

/** Reel-only flavour printed on each stub. Unknown reels get a plain seat. */
const STOCK: Record<string, { place: string; serial: string; lang?: string }> = {
  parasite: { place: 'Row B1', serial: '№ 000001', lang: 'ko' },
  mood: { place: 'Room 2046', serial: '№ 1962-02', lang: 'zh-Hant' },
  br2049: { place: 'Spinner deck', serial: '№ KD6-3.7' },
  budapest: { place: 'Lobby', serial: '№ 1932-04' },
  odyssey: { place: 'Pod bay', serial: '№ 2001-05' },
};

const house = REELS.find((r) => r.id === DEFAULT_REEL)!;
const films = REELS.filter((r) => r.id !== DEFAULT_REEL);

// The fan: tickets lean out from the middle one and drop a little.
const fan = (i: number) => {
  const c = i - (films.length - 1) / 2;
  return `--i:${i};--rot:${(c * 3.5).toFixed(2)}deg;--ty:${Math.round(4 * c * c + 3 * Math.abs(c))}px`;
};

// The marquee's letter board: every tile hangs a little crooked.
const lines = ['Now showing', profile.name, `In ${films.length} films · pick one`];
let k = 0;
const rows = lines.map((line, ri) =>
  [...line.toUpperCase()].map((ch, i) => {
    k += 1;
    const r = ((((i * 37 + ri * 11) % 7) - 3) * 0.5).toFixed(1);
    const y = ((((i * 13 + ri * 5) % 5) - 2) * 0.6).toFixed(1);
    return {
      ch: ch === ' ' ? '' : ch,
      sp: ch === ' ',
      style: `--r:${r}deg;--y:${y}px;--d:${k * 28}ms`,
    };
  }),
);

// Chasing bulbs round the marquee, in three phases.
const SIDE = 30;
const END = 5;
const bulbs = {
  top: Array.from({ length: SIDE }, (_, i) => i % 3),
  rgt: Array.from({ length: END }, (_, i) => (SIDE + i) % 3),
  bot: Array.from({ length: SIDE }, (_, i) => (SIDE + END + (SIDE - 1 - i)) % 3),
  lft: Array.from({ length: END }, (_, i) => (SIDE * 2 + END + (END - 1 - i)) % 3),
};

const total = (bands: [string, number][]) => bands.reduce((s, [, w]) => s + w, 0);

// '2019 · Bong Joon-ho · 2.39:1' prints as year · director, then the ratio below.
const metaLines = (meta: string) => {
  const parts = meta.split(' · ');
  return [parts.slice(0, 2).join(' · '), parts.slice(2).join(' · ')].filter(Boolean);
};
---

<dialog
  class="boxoffice"
  data-boxoffice
  data-phase="pick"
  aria-labelledby="bo-title"
  aria-describedby="bo-lead"
  tabindex="-1"
>
  <div class="bo-lobby">
    <div class="bo-grain" aria-hidden="true"></div>

    <header class="bo-top">
      <div class="bo-id">
        <svg class="bo-sig" viewBox="0 0 48 36" aria-hidden="true">
          <path d="M3 6 H25"></path><path d="M14 6 V31"></path><path d="M31 6 V31"></path>
          <path d="M31 6 H40 A6 6 0 0 1 40 18 H31"></path>
          <path d="M31 18 H42 A6.5 6.5 0 0 1 42 31 H31"></path>
        </svg>
        <div>
          <div class="bo-nm">{profile.name}</div>
          <div class="bo-rl">{profile.role}</div>
        </div>
      </div>
      <div class="bo-tr">
        <span class="bo-clock" aria-hidden="true">Rosario <span data-bo-clock>--:--:--</span></span>
        <button class="snd bo-snd" type="button" data-sound-toggle aria-pressed="true">
          <span class="w" aria-hidden="true"><i></i><i></i><i></i></span>
          <span data-sound-label>sound on</span>
        </button>
        <button
          class="bo-x"
          type="button"
          data-bo-close
          aria-label="Skip: House lights, the default site"
        >
          <span data-bo-close-label>skip</span><kbd>esc</kbd>
        </button>
      </div>
    </header>

    <div class="bo-marquee" aria-hidden="true">
      <div class="bo-bulbs top">{bulbs.top.map((p) => <i class={`bl k${p}`} />)}</div>
      <div class="bo-bulbs rgt">{bulbs.rgt.map((p) => <i class={`bl k${p}`} />)}</div>
      <div class="bo-bulbs bot">{bulbs.bot.map((p) => <i class={`bl k${p}`} />)}</div>
      <div class="bo-bulbs lft">{bulbs.lft.map((p) => <i class={`bl k${p}`} />)}</div>
      <div class="bo-board">
        {
          rows.map((row) => (
            <div class="bo-row">
              {row.map((c) => (
                <span class:list={['bo-tile', { sp: c.sp }]} style={c.style}>
                  <span class="bo-tl">{c.ch}</span>
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div class="bo-lead">
      <h2 id="bo-title">Pick a film. The portfolio is screened through it.</h2>
      <p id="bo-lead">
        Same work, same nine sections. Each film brings its own palette, type, layout, motion and
        sound. You can change reels any time from inside the page.
      </p>
    </div>

    <ul class="bo-tix" aria-label="Tickets">
      {
        films.map((r, i) => {
          const stock = STOCK[r.id] ?? { place: 'Row A', serial: `№ ${r.year ?? 1900}-${r.n}` };
          const label = `${r.title}, ${r.meta}`;
          return (
            <li class="bo-tkw" style={fan(i)}>
              <button
                class="bo-tk"
                type="button"
                data-bo-ticket={r.id}
                data-stock={r.id}
                data-label={label}
                aria-label={`${label}. Tear the ticket to start the screening`}
              >
                <span class="tk-main">
                  <span class="tk-deco" aria-hidden="true" />
                  <span class="tk-top">
                    <span>Admit one</span>
                    <span>Reel {r.n}</span>
                  </span>
                  <span class="tk-bc" aria-hidden="true">
                    {r.bands.map(([c, w]) => (
                      <i
                        style={`background:${c};flex-grow:${w};flex-basis:${(w / total(r.bands)) * 100}%`}
                      />
                    ))}
                  </span>
                  <span class="tk-ttl">{r.title}</span>
                  {r.native && (
                    <span class="tk-ko" lang={stock.lang}>
                      {r.native}
                    </span>
                  )}
                  <span class="tk-meta">
                    {metaLines(r.meta).map((l) => (
                      <span>{l}</span>
                    ))}
                  </span>
                  <span class="tk-now" aria-hidden="true">
                    Now screening
                  </span>
                </span>
                <span class="tk-stub">
                  <span class="tk-row">
                    <span>{stock.place}</span>
                    <span class="tk-dot"> · </span>
                    <span>Seat {r.n}</span>
                  </span>
                  <span>{stock.serial}</span>
                </span>
                <span class="tk-hint" aria-hidden="true">
                  <span class="h-tear">tear to start ↓</span>
                  <span class="h-seat">back to your seat</span>
                </span>
              </button>
            </li>
          );
        })
      }
    </ul>

    <footer class="bo-foot">
      <span class="bo-how">Tear a ticket to start the screening</span>
      <a class="bo-house" href="#readme" data-bo-house>
        <span class="bo-house-sw" aria-hidden="true">
          {
            house.bands.map(([c, w]) => (
              <i
                style={`background:${c};flex-grow:${w};flex-basis:${(w / total(house.bands)) * 100}%`}
              />
            ))
          }
        </span>
        <span class="bo-house-t">
          <b>{house.title}</b>
          <span>no film, straight to the portfolio →</span>
        </span>
        <span class="bo-house-now">now screening</span>
      </a>
      <span class="bo-fine">Fan homages, not affiliated with the films or their studios.</span>
    </footer>
  </div>

  <div class="bo-screen" aria-hidden="true">
    <div class="bo-leader">
      <span class="bo-sweep"></span>
      <span class="bo-cross"></span>
      <span class="bo-ring r1"></span>
      <span class="bo-ring r2"></span>
      <span class="bo-num" data-bo-num>3</span>
    </div>
    <div class="bo-flash"></div>
  </div>
</dialog>

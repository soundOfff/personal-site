---
import PixelSigil from '../../../components/PixelSigil.astro';
import { selected } from '../content/showcase';
import { workflow } from '../content/workflow';
import { wide, tall, route, type Layout, type Cell } from './layout';

const pad = (n: number) => String(n).padStart(2, '0');
const clock = (t: number) => `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, '0')}`;

const products = selected.map((p, i) => {
  const { chapters, duration } = p.demo;
  return {
    ...p,
    index: pad(i + 1),
    stack: p.project.stack.split(' · ').join(' / '),
    chapters: chapters.map((c, j) => ({ ...c, end: chapters[j + 1]?.t ?? duration })),
    label: `${p.project.name} demo: ${chapters.map((c) => c.label.toLowerCase()).join(', ')}.`,
  };
});

// Original sprites for the two agents. Not logos: a terminal with a prompt, and a round helper.
const sprites = {
  claude: ['########', '#......#', '#.#....#', '#..#...#', '#.#.##.#', '#......#', '########', '.#....#.'],
  codex: ['..####..', '.#....#.', '#.#..#.#', '#......#', '#.####.#', '.#....#.', '..#..#..', '.##..##.'],
};
const spriteCells = (rows: string[]) =>
  rows.flatMap((row, y) => [...row].flatMap((bit, x) => (bit === '#' ? [{ x, y }] : [])));

const stages = workflow.stages;
const toolsFor = (id: (typeof stages)[number]['id']) => workflow.tools[id];
const owner = (id: string) => (id === 'frame' || id === 'decide' ? 'me' : 'agents');
const edgeTone = (id: string) => (id === 'fix' || id === 'rethink' ? 'loop' : 'line');

const boards: Layout[] = [wide, tall];
// The lit room's 2 px ink outline, traced just outside its stepped corners.
const ring = ({ x, y, w, h }: { x: number; y: number; w: number; h: number }, d = 0.05) =>
  [
    [x + 0.5 - d, y - d], [x + w - 0.5 + d, y - d], [x + w - 0.5 + d, y + 0.5 - d], [x + w + d, y + 0.5 - d],
    [x + w + d, y + h - 0.5 + d], [x + w - 0.5 + d, y + h - 0.5 + d], [x + w - 0.5 + d, y + h + d],
    [x + 0.5 - d, y + h + d], [x + 0.5 - d, y + h - 0.5 + d], [x - d, y + h - 0.5 + d],
    [x - d, y + 0.5 - d], [x + 0.5 - d, y + 0.5 - d],
  ]
    .map(([px, py]) => `${+px.toFixed(2)},${+py.toFixed(2)}`)
    .join(' ');
const pos = (b: { x: number; y: number; w?: number; h?: number }) =>
  `--x:${b.x};--y:${b.y};--w:${b.w ?? 1};--h:${b.h ?? 1}`;
const arrowRects = (at: Cell, dir: 'down' | 'left') => {
  const [x, y] = at;
  return dir === 'down'
    ? [
        { x: x - 1, y: y - 1, w: 3, h: 0.5 },
        { x: x - 0.5, y: y - 0.5, w: 2, h: 0.5 },
        { x, y, w: 1, h: 0.5 },
      ]
    : [
        { x: x + 1.5, y: y - 1, w: 0.5, h: 3 },
        { x: x + 1, y: y - 0.5, w: 0.5, h: 2 },
        { x: x + 0.5, y, w: 0.5, h: 1 },
      ];
};
---

<div data-proto="a">
  <section class="section shell work" id="work" aria-labelledby="work-title">
    <div class="work-intro">
      <PixelSigil star />
      <p>Thoughtful interfaces.<br />Useful systems. All the way through.</p>
    </div>
    <div class="section-heading">
      <h2 id="work-title">Products <span class="ghost">in focus.</span></h2>
      <p>Independent tools for learning,<br />reading, and making.</p>
    </div>

    <div class="products">
      {
        products.map((p) => (
          <article class="product" data-demo aria-labelledby={`a-${p.project.id}`}>
            <header class="head">
              <p class="meta">
                {p.index} / {p.status}
              </p>
              <h3 id={`a-${p.project.id}`}>
                <a href={p.href}>{p.project.name}</a>
              </h3>
            </header>

            <figure class="stage">
              <div class="frame">
                <video
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={p.demo.poster}
                  aria-label={p.label}
                  width="1600"
                  height="1000"
                >
                  <source src={p.demo.webm} type="video/webm" />
                  <source src={p.demo.mp4} type="video/mp4" />
                </video>
                <button class="bigplay" type="button" data-bigplay>
                  <svg viewBox="0 0 8 7" aria-hidden="true" shape-rendering="crispEdges">
                    <rect x="0" y="0" width="2" height="7" /><rect x="2" y="1" width="2" height="5" />
                    <rect x="4" y="2" width="2" height="3" /><rect x="6" y="3" width="2" height="1" />
                  </svg>
                  Play the {p.project.name} demo
                  <span class="bigplay-time">{clock(p.demo.duration)}</span>
                </button>
                <div class="rail" role="group" aria-label={`${p.project.name} demo chapters, arrow keys to move`}>
                  {p.chapters.map((c, j) => (
                    <button
                      class="seg"
                      type="button"
                      tabindex={j === 0 ? 0 : -1}
                      data-t={c.t}
                      data-end={c.end}
                      data-label={c.label}
                      style={`--grow:${(c.end - c.t).toFixed(2)}`}
                      aria-label={`Chapter ${j + 1}, ${c.label}, at ${clock(c.t)}`}
                    >
                      <span class="fill" />
                    </button>
                  ))}
                </div>
              </div>
              <figcaption class="caption">
                <span class="cap-num" data-cap-num>
                  01/{pad(p.chapters.length)}
                </span>
                <span class="cap-label" data-cap-label>
                  {p.chapters[0].label}
                </span>
                <span class="cap-time">{clock(p.demo.duration)} loop</span>
                <button class="toggle" type="button" data-toggle aria-label={`Play the ${p.project.name} demo`}>
                  <svg class="icon-play" viewBox="0 0 8 7" aria-hidden="true" shape-rendering="crispEdges">
                    <rect x="0" y="0" width="2" height="7" /><rect x="2" y="1" width="2" height="5" />
                    <rect x="4" y="2" width="2" height="3" /><rect x="6" y="3" width="2" height="1" />
                  </svg>
                  <svg class="icon-pause" viewBox="0 0 8 7" aria-hidden="true" shape-rendering="crispEdges">
                    <rect x="1" y="0" width="2" height="7" /><rect x="5" y="0" width="2" height="7" />
                  </svg>
                </button>
              </figcaption>
            </figure>

            <div class="body">
              <p class="desc">{p.project.description}</p>
              <p class="meta stack">{p.stack}</p>
              <p class="links">
                <a class="small-link" href={p.href}>
                  Read the case study <span aria-hidden="true">→</span>
                </a>
                {p.demo.walkthrough && (
                  <a class="small-link quiet" href={p.demo.walkthrough} target="_blank" rel="noopener">
                    Narrated walkthrough <span aria-hidden="true">↗</span>
                  </a>
                )}
                {!p.demo.walkthrough && p.project.source && (
                  <a class="small-link quiet" href={p.project.source} target="_blank" rel="noopener">
                    Source <span aria-hidden="true">↗</span>
                  </a>
                )}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section shell flow" id="workflow" aria-labelledby="workflow-title">
    <div class="section-heading">
      <h2 id="workflow-title">My AI <span class="ghost">workflow.</span></h2>
      <p>
        Claude Code and Codex explore, build and challenge the work. I frame it and make the
        final call.
      </p>
    </div>

    <div class="owners">
      <span class="owner"
        ><PixelSigil star class="me-mark" /><span
          >Tomas frames and decides, and asks the <span class="keep"><PixelSigil star class="ask-mark" /> question</span> at
          each stage</span
        ></span
      >
      <span class="owner"
        ><svg class="sprite" viewBox="0 0 8 8" aria-hidden="true" shape-rendering="crispEdges"
          >{spriteCells(sprites.claude).map(({ x, y }) => <rect x={x} y={y} width="1" height="1" />)}</svg
        ><svg class="sprite alt" viewBox="0 0 8 8" aria-hidden="true" shape-rendering="crispEdges"
          >{spriteCells(sprites.codex).map(({ x, y }) => <rect x={x} y={y} width="1" height="1" />)}</svg
        > Claude Code and Codex design, build and review, with me</span
      >
    </div>

    {
      boards.map((b) => (
        <figure
          class:list={['board', b.name]}
          style={`--cols:${b.cols};--rows:${b.rows}`}
          data-board={b.name}
          data-edges={JSON.stringify(b.edges)}
          data-route={JSON.stringify(route)}
        >
          <svg
            class="pixels"
            viewBox={`0 0 ${b.cols} ${b.rows}`}
            aria-hidden="true"
            shape-rendering="crispEdges"
          >
            <defs>
              <pattern id={`a-line-${b.name}`} width="0.2" height="0.2" patternUnits="userSpaceOnUse">
                <rect width="0.2" height="0.2" style="fill: var(--light)" />
                <rect width="0.1" height="0.1" style="fill: var(--blue)" />
                <rect x="0.1" y="0.1" width="0.1" height="0.1" style="fill: var(--blue)" />
              </pattern>
              <pattern id={`a-loop-${b.name}`} width="0.2" height="0.2" patternUnits="userSpaceOnUse">
                <rect width="0.2" height="0.2" style="fill: var(--paper)" />
                <rect width="0.1" height="0.1" style="fill: var(--light)" />
                <rect x="0.1" y="0.1" width="0.1" height="0.1" style="fill: var(--light)" />
              </pattern>
            </defs>
            {Object.entries(b.edges).map(([id, cells]) => (
              <g fill={`url(#a-${edgeTone(id)}-${b.name})`}>
                {cells.map(([x, y]) => (
                  <rect x={x} y={y} width="1" height="1" />
                ))}
              </g>
            ))}
            <g class="arrows">
              {b.arrows.flatMap((a) =>
                arrowRects(a.at, a.dir).map((r) => <rect x={r.x} y={r.y} width={r.w} height={r.h} />),
              )}
            </g>
            {stages.map((s) => {
              const r = b.rooms[s.id];
              return (
                <g class:list={['room', owner(s.id)]} data-room={s.id}>
                  <rect x={r.x + 0.5} y={r.y} width={r.w - 1} height={r.h} />
                  <rect x={r.x} y={r.y + 0.5} width={r.w} height={r.h - 1} />
                  <polygon class="ring" points={ring(r)} />
                </g>
              );
            })}
            <rect class="walker" x="-2" y="-2" width="0.5" height="0.5" />
          </svg>

          <div class="overlay">
            {b.lanes && (
              <>
                <div class="lane" style={pos(b.lanes.me)}>
                  <p class="lane-who">
                    <PixelSigil star class="me-mark" /> Tomas
                  </p>
                  <p class="lane-what">
                    Frames the problem, asks the <span class="keep"><PixelSigil star class="ask-mark" /> question</span> at each
                    stage and makes the final call.
                  </p>
                </div>
                <div class="lane" style={pos(b.lanes.agents)}>
                  <p class="lane-who">
                    <svg class="sprite" viewBox="0 0 8 8" aria-hidden="true" shape-rendering="crispEdges">
                      {spriteCells(sprites.claude).map(({ x, y }) => (
                        <rect x={x} y={y} width="1" height="1" />
                      ))}
                    </svg>
                    Claude Code <span class="model">{workflow.agents[0].model}</span>
                  </p>
                  <p class="lane-who">
                    <svg class="sprite alt" viewBox="0 0 8 8" aria-hidden="true" shape-rendering="crispEdges">
                      {spriteCells(sprites.codex).map(({ x, y }) => (
                        <rect x={x} y={y} width="1" height="1" />
                      ))}
                    </svg>
                    Codex CLI <span class="model">{workflow.agents[1].model}</span>
                  </p>
                  <p class="lane-what">Design, build and review in their own worktrees, with me.</p>
                </div>
              </>
            )}
            <ol class="stages">
              {stages.map((s, i) => {
                const tools = toolsFor(s.id);
                return (
                  <li>
                    <p class:list={['room-label', owner(s.id)]} style={pos(b.rooms[s.id])}>
                      <span class="num">{pad(i + 1)}</span>
                      <span class="name">{s.label}</span>
                    </p>
                    <div class="note" style={pos(b.notes[s.id])}>
                      <p class="hint">{s.hint}</p>
                      <p class="ask">
                        <PixelSigil star class="ask-mark" />
                        <span class="sr-only">My question: </span>
                        {s.humanDecision}
                      </p>
                      {tools.length > 0 && (
                        <ul class="tools" aria-label={`Tools for ${s.label}`}>
                          {tools.map((t) => (
                            <li data-kind={t.kind} data-source={t.source}>
                              <i class="sw" aria-hidden="true" />
                              {t.name}
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </li>
                );
              })}
            </ol>
            {b.labels.fix && (
              <p class="loop-label" style={pos(b.labels.fix)}>
                Checks fail, back to Build
              </p>
            )}
            {b.labels.rethink && (
              <p class="loop-label" style={pos(b.labels.rethink)}>
                Wrong approach, back to Design
              </p>
            )}
          </div>
        </figure>
      ))
    }

    <div class="legend">
      <p class="loops-key">
        <span class="key-loop" aria-hidden="true"></span>
        {workflow.feedback.body}
      </p>
      <ul class="sources" aria-label="Where the skills come from">
        <li data-source="pstack"><i class="sw" aria-hidden="true"></i><a href={workflow.sources[0].href}>pstack</a></li>
        <li data-source="Matt Pocock"><i class="sw" aria-hidden="true"></i><a href={workflow.sources[1].href}>Matt Pocock’s skills</a></li>
        <li data-source="flow kit"><i class="sw" aria-hidden="true"></i><a href={workflow.sources[2].href}>My flow kit</a></li>
        <li data-kind="agent"><i class="sw" aria-hidden="true"></i>Agents, Orca and checks</li>
      </ul>
    </div>
  </section>
</div>

<script>
  import { initDemos } from './demos';
  import { initFlow } from './flow';
  import { initSettle } from '../settle';

  const root = document.querySelector<HTMLElement>('[data-proto="a"]');
  if (root) {
    initSettle(root);
    initDemos(root);
    initFlow(root);
  }
</script>

<style is:inline>
  /* Section starts and product rows are targets for the shared directional settle (settle.ts),
     which replaces CSS snapping: proximity pulled slow wheel notches back. */
  html:has([data-proto='a']) {
    scroll-snap-type: none !important;
  }
  html:has([data-proto='a']) .cover {
    scroll-snap-align: none;
  }
  @media (prefers-reduced-motion: no-preference) and (min-height: 640px) {
    html:has([data-proto='a']) [data-proto='a'] #work,
    html:has([data-proto='a']) [data-proto='a'] .product,
    html:has([data-proto='a']) [data-proto='a'] #workflow,
    html:has([data-proto='a']) .experience,
    html:has([data-proto='a']) #index,
    html:has([data-proto='a']) #readme,
    html:has([data-proto='a']) .writing,
    html:has([data-proto='a']) #playground,
    html:has([data-proto='a']) #contact {
      scroll-snap-align: start;
    }
  }
  html:has([data-proto='a']) .cover,
  html:has([data-proto='a']) [data-proto='a'] #work,
  html:has([data-proto='a']) [data-proto='a'] #workflow,
  html:has([data-proto='a']) .experience,
  html:has([data-proto='a']) #index,
  html:has([data-proto='a']) #readme,
  html:has([data-proto='a']) .writing,
  html:has([data-proto='a']) #playground,
  html:has([data-proto='a']) #contact {
    scroll-margin-top: -100px;
  }
  @media (max-width: 600px) {
    html:has([data-proto='a']) .cover,
    html:has([data-proto='a']) [data-proto='a'] #work,
    html:has([data-proto='a']) [data-proto='a'] #workflow,
    html:has([data-proto='a']) .experience,
    html:has([data-proto='a']) #index,
    html:has([data-proto='a']) #readme,
    html:has([data-proto='a']) .writing,
    html:has([data-proto='a']) #playground,
    html:has([data-proto='a']) #contact {
      scroll-margin-top: -80px;
    }
  }
</style>

<style is:inline>
  /* Projects */
  html:has([data-proto='a']) [data-proto='a'] .work .section-heading {
    margin-bottom: 60px;
  }
  html:has([data-proto='a']) [data-proto='a'] .products {
    display: grid;
    gap: 120px;
  }
  html:has([data-proto='a']) [data-proto='a'] .product {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.25fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'head stage'
      'body stage';
    column-gap: 48px;
  }
  html:has([data-proto='a']) [data-proto='a'] .head {
    grid-area: head;
    padding-top: 20px;
  }
  html:has([data-proto='a']) [data-proto='a'] .head .meta {
    color: var(--muted);
  }
  html:has([data-proto='a']) [data-proto='a'] .head h3 {
    margin-top: 14px;
    font-size: clamp(30px, 3vw, 40px);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  html:has([data-proto='a']) [data-proto='a'] .head h3 a {
    color: inherit;
    text-decoration: none;
  }
  html:has([data-proto='a']) [data-proto='a'] .body {
    grid-area: body;
    padding-top: 18px;
  }
  html:has([data-proto='a']) [data-proto='a'] .desc {
    max-width: 380px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  html:has([data-proto='a']) [data-proto='a'] .stack {
    margin-top: 16px;
    color: var(--muted);
  }
  html:has([data-proto='a']) [data-proto='a'] .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 28px;
  }
  html:has([data-proto='a']) [data-proto='a'] .small-link {
    color: inherit;
    text-decoration: none;
  }
  html:has([data-proto='a']) [data-proto='a'] .small-link.quiet {
    color: var(--muted);
    border-bottom-color: var(--line);
  }

  html:has([data-proto='a']) [data-proto='a'] .stage {
    grid-area: stage;
    margin: 0;
    min-width: 0;
  }
  /* A 1-cell frame of the cave's 2 px dither with the corner cells knocked out. Its bottom
       edge is the chapter rail, drawn solid so it reads against the dither. */
  html:has([data-proto='a']) [data-proto='a'] .frame {
    --cell: 20px;
    position: relative;
    padding: var(--cell) var(--cell) 0;
    background: repeating-conic-gradient(var(--light) 0 25%, var(--paper) 0 50%) 0 0 / 4px 4px;
    clip-path: polygon(
      var(--cell) 0,
      calc(100% - var(--cell)) 0,
      calc(100% - var(--cell)) var(--cell),
      100% var(--cell),
      100% calc(100% - var(--cell)),
      calc(100% - var(--cell)) calc(100% - var(--cell)),
      calc(100% - var(--cell)) 100%,
      var(--cell) 100%,
      var(--cell) calc(100% - var(--cell)),
      0 calc(100% - var(--cell)),
      0 var(--cell),
      var(--cell) var(--cell)
    );
  }
  html:has([data-proto='a']) [data-proto='a'] video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--paper-3);
  }
  html:has([data-proto='a']) [data-proto='a'] .rail {
    display: flex;
    gap: 4px;
    height: var(--cell);
    margin-inline: calc(var(--cell) * -1);
    padding-inline: var(--cell);
    background: var(--paper);
  }
  html:has([data-proto='a']) [data-proto='a'] .seg {
    all: unset;
    position: relative;
    flex: var(--grow) 1 0;
    background: var(--light);
    cursor: pointer;
  }
  html:has([data-proto='a']) [data-proto='a'] .seg::before {
    content: '';
    position: absolute;
    inset: -8px 0 -14px;
  }
  html:has([data-proto='a']) [data-proto='a'] .seg .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--p, 0px);
    background: var(--blue);
  }
  /* Inset, because the frame's clip-path would cut an outer ring. */
  html:has([data-proto='a']) [data-proto='a'] .seg:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: -3px;
  }
  html:has([data-proto='a']) [data-proto='a'] .toggle {
    all: unset;
    position: relative;
    align-self: center;
    flex: none;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    margin-right: -6px;
    color: var(--blue);
    cursor: pointer;
  }
  html:has([data-proto='a']) [data-proto='a'] .toggle svg {
    width: 16px;
    height: 14px;
    fill: currentColor;
  }
  html:has([data-proto='a']) [data-proto='a'] .toggle:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 2px;
  }
  html:has([data-proto='a']) [data-proto='a'] .product:not([data-playing='true']) .icon-pause,
  html:has([data-proto='a']) [data-proto='a'] .product[data-playing='true'] .icon-play {
    display: none;
  }
  /* One play control at a time: the labelled one in the frame while the demo is held. */
  html:has([data-proto='a']) [data-proto='a'] .product[data-hold='true'] .toggle {
    display: none;
  }
  html:has([data-proto='a']) [data-proto='a'] .bigplay {
    all: unset;
    position: absolute;
    left: 50%;
    top: calc(50% - 10px);
    transform: translate(-50%, -50%);
    display: none;
    align-items: center;
    gap: 10px;
    padding: 12px 18px 12px 12px;
    background: var(--blue);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 12px;
    white-space: nowrap;
    width: max-content;
    cursor: pointer;
  }
  html:has([data-proto='a']) [data-proto='a'] .bigplay svg {
    flex: none;
    width: 16px;
    height: 14px;
    fill: currentColor;
  }
  html:has([data-proto='a']) [data-proto='a'] .bigplay-time {
    padding-left: 10px;
    border-left: 2px solid var(--light);
    font-variant-numeric: tabular-nums;
  }

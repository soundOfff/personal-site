---
import '@fontsource-variable/geist';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import './candidate.css';
import { publicPosts } from '../../../lib/discovery/documents';

const posts = await publicPosts();
const date = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const featured = posts[0];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3449df" />
    <meta name="description" content="Writing by Tomas Brasca about AI systems, product engineering, algorithms and lessons from building software." />
    <title>Journal — Tomas Brasca</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="candidate-three journal-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <main>
    <div class="journal-top">
      <header class="site-header wrap">
        <a class="brand" href="/designs/candidate-3/" aria-label="Tomas Brasca, candidate 3 home">Tomas<span>Brasca</span><span class="brand-mark" aria-hidden="true">✳</span></a>
        <nav aria-label="Main navigation"><a href="/designs/candidate-3/#work">Work</a><a href="/designs/candidate-3/blog" aria-current="page">Writing</a><a href="/designs/candidate-3/#about">About</a><a class="nav-contact" href="mailto:tomibrasca97@gmail.com">Get in touch </a></nav>
      </header>
        <section class="journal-hero wrap" id="main" aria-labelledby="journal-title"><p class="journal-overline">A working notebook / {posts.length} published pieces</p><h1 id="journal-title">Notes from<br /><em>the making.</em></h1><div class="journal-hero-bottom"><p>Things I learned while building products, untangling backend systems and practicing the fundamentals. Written to make the next decision clearer.</p><span aria-hidden="true">↓</span></div></section>
    </div>

    <section class="journal-feature wrap" aria-labelledby="latest-title"><div class="feature-number"><span>Most recent</span><span>From the journal</span></div><div class="journal-feature-grid"><p class="feature-date"><time datetime={featured.data.date.toISOString()}>{date.format(featured.data.date)}</time><br />{featured.data.pillar}</p><div><h2 id="latest-title"><a href={`/blog/${featured.id}`}>{featured.data.title}</a></h2><p>{featured.data.description}</p><a class="text-link" href={`/blog/${featured.id}`}>Read article </a></div></div></section>

    <section class="journal-index wrap" aria-labelledby="all-articles-title"><div class="journal-index-intro"><div><p class="section-kicker">The archive</p><h2 id="all-articles-title">All writing.</h2></div><p>From production decisions to contest techniques, these are the ideas I keep coming back to.</p></div><ol class="article-list">{posts.map((post) => <li><article class="article-row"><div class="article-meta"><time datetime={post.data.date.toISOString()}>{date.format(post.data.date)}</time><span>{post.data.pillar}</span></div><div class="article-text"><h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3><p>{post.data.description}</p><span class="read-time">{post.data.readingTime} read</span></div></article></li>)}</ol></section>
    </main>

    <footer class="footer"><div class="wrap"><p>Have a thought to compare notes on?</p><a class="footer-email" href="mailto:tomibrasca97@gmail.com">Let’s talk</a><div class="footer-bottom"><span>Tomas Brasca / Rosario, Argentina</span><div><a href="/designs/candidate-3/">Portfolio</a><a href="https://github.com/soundOfff" target="_blank" rel="noopener noreferrer">GitHub</a><a href="/designs">All designs</a><a href="#main">Back to top ↑</a></div></div></div></footer>
  </body>
</html>

---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import './candidate.css';
import { publicPosts } from '../../../lib/discovery/documents';

const posts = await publicPosts();
const pillars = [...new Set(posts.map((post) => post.data.pillar))];
const date = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5fcfa" />
    <meta name="description" content="Writing by Tomas Brasca about product engineering, AI systems, algorithms, and the work behind the work." />
    <title>Writing · Tidal Studio</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="candidate-five journal-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href="/designs/candidate-5" aria-label="Tomas Brasca, home">Tomas<span>Brasca</span><b aria-hidden="true">✦</b></a>
      <nav aria-label="Main navigation"><a href="/designs/candidate-5#selected">Work</a><a href="/designs/candidate-5#index">Index</a><a href="/designs/candidate-5/blog" aria-current="page">Writing</a><a href="/designs/candidate-5#contact">Contact</a></nav>
      <a class="header-switch" href="/designs">View designs </a>
    </header>
    <main id="main">
      <section class="journal-hero shell"><div class="journal-headline"><p class="availability"><span class="availability-dot" aria-hidden="true"></span> A working journal by Tomas Brasca</p><h1>Notes from<br /><em>the workbench.</em></h1></div><div class="journal-aside"><span class="journal-asterisk" aria-hidden="true">✦</span><p>Field notes on building products, making systems behave, and learning what matters after the demo.</p><p><span data-total-count>{posts.length}</span> articles · {pillars.length} themes</p></div></section>
      <section class="journal-section shell" aria-labelledby="all-articles">
        <div class="journal-section-head">
          <h2 id="all-articles">All articles</h2>
          <div class="journal-controls">
            <div class="journal-search">
              <input
                type="text"
                placeholder="Search articles..."
                aria-label="Search articles by title or description"
                data-journal-search
              />
              <span class="journal-result-count" data-result-count aria-live="polite"></span>
              <button class="journal-search-clear" data-search-clear aria-label="Clear search">×</button>
            </div>
            <div class="journal-topic-chips" role="group" aria-label="Filter by topic">
              <button class="topic-chip" data-topic-chip="" aria-pressed="true">All topics</button>
              {pillars.map((pillar) => (
                <button
                  class="topic-chip"
                  data-topic-chip={pillar}
                  aria-pressed="false"
                >
                  {pillar}
                </button>
              ))}
            </div>
          </div>
        </div>
        <ol class="article-list">
          {posts.map((post) => (
            <li data-journal-entry data-pillar={post.data.pillar} data-title={post.data.title.toLowerCase()} data-description={post.data.description.toLowerCase()}>
              <article class="article-row">
                <div class="article-meta">
                  <time datetime={post.data.date.toISOString()}>{date.format(post.data.date)}</time>
                  <span>{post.data.pillar}</span>
                </div>
                <div class="article-copy">
                  <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                  <p>{post.data.description}</p>
                  <span>{post.data.readingTime} read</span>
                </div>

              </article>
            </li>
          ))}
        </ol>
        <div class="journal-empty" data-empty-results hidden><p>No articles match those filters.</p><button type="button" data-reset-filters>Show all articles</button></div>
      </section>
      <aside class="journal-end shell"><span class="journal-asterisk" aria-hidden="true">✦</span><div><p>Interested in the projects behind these notes?</p><a class="text-link" href="/designs/candidate-5#selected">Explore selected work </a></div></aside>
    </main>
    <footer id="contact" class="site-footer"><div class="shell"><div class="footer-top"><p>Have a product problem<br />worth thinking through?</p><a href="mailto:tomibrasca97@gmail.com">Let's talk </a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Tomas Brasca</span><div><a href="mailto:tomibrasca97@gmail.com">Email</a><a href="https://github.com/soundOfff" target="_blank" rel="noopener noreferrer">GitHub</a><a href="/designs/candidate-5">Work</a><a href="/designs">Designs</a></div><span>Rosario · UTC−3</span></div></div></footer>
  </body>
</html>

<script>
  interface FilterState {
    selectedTopic: string | null;
    searchQuery: string;
  }

  const searchInput = document.querySelector<HTMLInputElement>('[data-journal-search]');
  const searchClear = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const resultCount = document.querySelector<HTMLElement>('[data-result-count]');
  const emptyResults = document.querySelector<HTMLElement>('[data-empty-results]');
  const resetFilters = document.querySelector<HTMLButtonElement>('[data-reset-filters]');
  const topicChips = document.querySelectorAll<HTMLButtonElement>('[data-topic-chip]');
  const entries = document.querySelectorAll<HTMLElement>('[data-journal-entry]');

  const state: FilterState = {
    selectedTopic: null,
    searchQuery: '',
  };

  function updateDisplay() {
    let visibleCount = 0;

    entries.forEach((entry) => {
      const entryPillar = entry.dataset.pillar || '';
      const entryTitle = entry.dataset.title || '';
      const entryDescription = entry.dataset.description || '';

      const matchesTopic = !state.selectedTopic || entryPillar === state.selectedTopic;
      const matchesSearch = !state.searchQuery ||
        entryTitle.includes(state.searchQuery.toLowerCase()) ||
        entryDescription.includes(state.searchQuery.toLowerCase());

      const isVisible = matchesTopic && matchesSearch;
      entry.hidden = !isVisible;

      if (isVisible) visibleCount++;
    });

    if (resultCount) resultCount.textContent = `${visibleCount} result${visibleCount === 1 ? '' : 's'}`;
    if (emptyResults) emptyResults.hidden = visibleCount > 0;
    if (searchClear) searchClear.hidden = !state.searchQuery;
    topicChips.forEach((chip) => chip.setAttribute('aria-pressed', String((chip.dataset.topicChip || null) === state.selectedTopic)));
  }

  searchInput?.addEventListener('input', () => {
    state.searchQuery = searchInput.value.trim();
    updateDisplay();
  });

  searchClear?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      state.searchQuery = '';
      updateDisplay();
      searchInput.focus();
    }
  });

  topicChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const topic = chip.dataset.topicChip || '';

      if (state.selectedTopic === topic) {
        state.selectedTopic = null;
        chip.setAttribute('aria-pressed', 'false');
      } else {
        topicChips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
        state.selectedTopic = topic || null;
        chip.setAttribute('aria-pressed', 'true');
      }

      updateDisplay();
    });
  });
  resetFilters?.addEventListener('click', () => {
    state.selectedTopic = null;
    state.searchQuery = '';
    if (searchInput) searchInput.value = '';
    updateDisplay();
    searchInput?.focus();
  });
  updateDisplay();
</script>

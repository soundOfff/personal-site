---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import { publicPosts } from '../../lib/discovery/documents';
const previewPosts = (await publicPosts()).slice(0,3);
const variants = [
  { id: 1, name: 'Cobalt studio', line: 'The original direction you liked.', description: 'Paper and cobalt, oversized editorial type, and large product canvases. A clear home for projects, professional experience and writing.', palette: ['#f5f3ee', '#173dc9', '#1d2928'], badge: 'Original favorite', title: 'Software with', emphasis: 'something to say.', journal: 'Writing from', journalEmphasis: 'inside the work.', image: '/previews/sift.png', project: 'SIFT' },
  { id: 4, name: 'Pigment Studio', line: 'Warm paper. Deep blue. Work you can explore.', description: 'A Cobalt variation with Sanzo Wada combination 126. Switch product previews, filter the project index, and browse writing by topic.', palette: ['#ebd999', '#e0b81f', '#0024cc'], badge: 'New · Wada 126', title: 'Ideas made', emphasis: 'useful.', journal: 'Thinking', journalEmphasis: 'out loud.', image: '/previews/sift.png', project: 'SIFT / FOCUSQUOTE / CATCHER' },
  { id: 5, name: 'Tidal Studio', line: 'Cool color. Clear detail. A closer look.', description: 'Sanzo Wada combination 119 brings pale blue-green and navy to Cobalt. Open project quick views and search the matching journal.', palette: ['#a6e6db', '#0d2b52', '#f4f8f5'], badge: 'New · Wada 119', title: 'Making things', emphasis: 'worth using.', journal: 'Notes from', journalEmphasis: 'the workbench.', image: '/previews/sift.png', project: 'PRODUCTS & ENGINEERING' },
  { id: 2, name: 'Editorial', line: 'A quieter, experience-led portfolio.', description: 'A restrained serif identity, spacious project stories, and a journal with topic filtering. Best when the work and writing should do most of the talking.', palette: ['#fafafa', '#1a1a1a', '#2563eb'], badge: '', title: 'Tomas Brasca', emphasis: '', journal: 'Blog', journalEmphasis: '', image: '/previews/dex.webp', project: 'DEX' },
  { id: 3, name: 'Night shift', line: 'A darker, more immersive direction.', description: 'Forest green, lime typography, and generous screenshot stages. A stronger visual signature with a matching dark journal.', palette: ['#14201d', '#d5ed89', '#e2e8d7'], badge: '', title: 'I build the', emphasis: 'whole thing.', journal: 'Notes from', journalEmphasis: 'the making.', image: '/previews/sift.png', project: 'SIFT' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Five portfolio directions · Tomas Brasca</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
  <div class="design-room">
    <header><a href="/">Tomas Brasca</a><span>Portfolio + journal / Design study</span><a href="/#oss">Current portfolio </a></header>
    <main>
      <div class="room-intro"><p>Cobalt Studio, explored further.</p><h1>A portfolio with<br /><em>more to show.</em></h1><div><span>Explore each direction at full size. Two new interactive directions join the original three. Each connects to the same project stories, screenshots and demos.</span><a href="#projects">Jump to the showcases ↓</a></div></div>
      <div class="view-switch" aria-label="Preview page"><button type="button" data-view="portfolio" aria-pressed="true">Portfolio</button><button type="button" data-view="blog" aria-pressed="false">Journal</button><span>Composition previews · Open a direction to explore</span></div>
      <section class="directions" aria-label="Portfolio design variants">
        {variants.map((v) => <article class="direction">
          <div class="direction-meta"><span>Direction 0{v.id}</span>{v.badge && <strong>{v.badge}</strong>}</div>
          <a class="miniature-link" data-variant-id={v.id} href={`/designs/candidate-${v.id}`} aria-label={`Open ${v.name} portfolio`}>
            <div class:list={['miniature', `mini-${v.id}`]} data-miniature aria-hidden="true">
              <div class="mini-nav"><b>Tomas Brasca <i>✳</i></b><span>Work &nbsp; Writing &nbsp; Contact</span></div>
              <div class="mini-portfolio" data-mini-portfolio>
                <p>Full-stack software engineer / Rosario, Argentina</p>
                <h4>{v.title}{v.emphasis && <><br/><em>{v.emphasis}</em></>}</h4>
                {v.id === 2 && <p class="mini-description">Building AI products from idea to production.<br/>Web, mobile and the systems behind them.</p>}
                <div class="mini-work"><span>{v.project}</span><img src={v.image} alt="" loading="lazy" /></div>
              </div>
              <div class="mini-blog" data-mini-blog hidden><p>A working journal / Tomas Brasca</p><h4>{v.journal}{v.journalEmphasis && <><br/><em>{v.journalEmphasis}</em></>}</h4>{previewPosts.map((post) => <div class="mini-post"><span>{post.data.pillar}</span><strong>{post.data.title}</strong></div>)}</div>
            </div>
            <span class="open-preview">Explore full size </span>
          </a>
          <div class="direction-title"><h2>{v.name}</h2><div class="swatches" aria-hidden="true">{v.palette.map((color) => <i style={`background:${color}`} />)}</div></div>
          <h3>{v.line}</h3><p>{v.description}</p>
          <nav aria-label={`${v.name} previews`}><a href={`/designs/candidate-${v.id}`}>Open portfolio </a><a href={`/designs/candidate-${v.id}/blog`}>Open journal </a></nav>
        </article>)}
      </section>
      <section class="showcase-index" id="projects"><div><p>Beyond the cover</p><h2>The work,<br /><em>in context.</em></h2><span>Each featured project now has a dedicated page with the problem, my contribution, the product flow, and the clearest available preview.</span></div><div class="showcase-links">
        <a href="/showcase/catcher"><span>01</span><div><strong>Catcher</strong><p>Watch the actual extension capture a component.</p></div><b>Recorded demo </b></a>
        <a href="/showcase/60-seconds"><span>02</span><div><strong>60 Seconds to Prompt</strong><p>Explore the prompt-to-interface flow with sample responses.</p></div><b>Interactive sample </b></a>
        <a href="/showcase/sift"><span>03</span><div><strong>Sift</strong><p>Walk through capture, learning blocks and the notebook library.</p></div><b>Product walkthrough </b></a>
        <a href="/showcase/letterboxd"><span>04</span><div><strong>Letterboxd Story</strong><p>Browse generated scenes and open the finished booklet.</p></div><b>Generated artifact </b></a>
        <a href="/showcase/dex"><span>05</span><div><strong>Dex & Mint Mobile</strong><p>Explore the product context and my engineering contributions.</p></div><b>Professional work </b></a>
        <a href="/showcase/focus-quote"><span>06</span><div><strong>FocusQuote</strong><p>From saved passages to focus sessions and active recall.</p></div><b>Product walkthrough </b></a>
      </div></section>
    </main>
    <p class="palette-credit">The new palettes use combinations 126 and 119 from <a href="https://sanzo-wada.dmbk.io/" target="_blank" rel="noreferrer">Sanzo Wada’s Dictionary of Color Combinations </a>.</p>
    <footer><span>All work under <a href="https://github.com/soundOfff">soundOfff</a>.</span><a href="/">Return to the portfolio </a></footer>
  </div>
  </body>
</html>
<script>
  const controls = document.querySelectorAll<HTMLButtonElement>('[data-view]');
  controls.forEach((button) => button.addEventListener('click', () => {
    const blog = button.dataset.view === 'blog';
    controls.forEach((control) => control.setAttribute('aria-pressed', String(control === button)));
    document.querySelectorAll<HTMLElement>('[data-mini-portfolio]').forEach((panel) => { panel.hidden = blog; });
    document.querySelectorAll<HTMLElement>('[data-mini-blog]').forEach((panel) => { panel.hidden = !blog; });
    document.querySelectorAll<HTMLAnchorElement>('.miniature-link').forEach((link) => {
      const id = link.dataset.variantId;
      link.href = `/designs/candidate-${id}${blog ? '/blog' : ''}`;
      link.setAttribute('aria-label', `Open direction ${id} ${blog ? 'journal' : 'portfolio'}`);
    });
  }));
</script>
<style>
  :global(body){margin:0} :global(*),:global(*::before),:global(*::after){box-sizing:border-box}
  .design-room{background:#f5f3ee;color:#1d2928;font-family:'Geist Variable',sans-serif;padding:0 max(24px,calc((100vw - 1380px)/2));min-height:100vh}.design-room a{color:inherit;text-decoration:none}.design-room a:hover{text-decoration:underline;text-underline-offset:4px}.design-room :focus-visible{outline:2px solid #173dc9;outline-offset:4px}.design-room header{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:25px 0;border-bottom:1px solid #cbd0ca;font-size:13px}.design-room header>a:first-child{font-weight:650}.design-room header>span{font-size:11px;color:#65716b}.room-intro{position:relative;padding:68px 0 48px}.room-intro>p{font-size:12px;letter-spacing:.04em;color:#65716b;margin:0 0 26px}.room-intro h1{font-size:clamp(60px,7.3vw,112px);letter-spacing:-.07em;font-weight:500;line-height:.95;margin:0}.room-intro h1 em{font-family:'Newsreader Variable',Georgia,serif;font-weight:400}.room-intro>div{position:absolute;right:0;bottom:52px;max-width:340px;font-size:16px;line-height:1.55}.room-intro>div a{display:block;font-size:13px;margin-top:20px}.view-switch{display:flex;gap:6px;align-items:center;margin:0 0 26px;padding-top:28px;border-top:1px solid #cbd0ca}.view-switch button{font:inherit;font-size:13px;padding:10px 20px;border:1px solid #cbd0ca;border-radius:4px;background:transparent;color:#1d2928;cursor:pointer}.view-switch button[aria-pressed=true]{background:#1d2928;color:#fff;border-color:#1d2928}.view-switch>span{margin-left:auto;color:#65716b;font-size:11px}.directions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.direction-meta{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px;font-size:11px;color:#65716b}.direction-meta strong{color:#173dc9;font-weight:500}.miniature-link{display:block;border:1px solid #cbd0ca;border-radius:5px;overflow:hidden}.miniature{position:relative;width:100%;aspect-ratio:1.32;background:#e9e8e1;overflow:hidden}.open-preview{display:block;background:#fff;padding:12px 14px;font-size:11px;text-align:right;border-top:1px solid #cbd0ca}.direction-title{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-top:23px}.direction-title h2{font-size:27px;letter-spacing:-.045em;font-weight:500;margin:0}.swatches{display:flex;gap:4px}.swatches i{display:block;width:15px;height:15px;border-radius:50%;border:1px solid #bbb}.direction h3{font-weight:500;font-size:14px;line-height:1.4;margin:14px 0 10px}.direction>p{font-size:13px;line-height:1.65;color:#65716b;margin:0;max-width:43ch}.direction nav{display:flex;gap:22px;flex-wrap:wrap;font-size:12px;margin-top:22px}.direction nav a{border-bottom:1px solid #b7bdb5;padding-bottom:4px}.showcase-index{display:grid;grid-template-columns:.8fr 1.4fr;gap:80px;padding:80px 0;margin-top:75px;border-top:1px solid #cbd0ca}.showcase-index>div>p{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#65716b;margin:0 0 22px}.showcase-index h2{font-size:clamp(44px,5vw,70px);line-height:.98;letter-spacing:-.055em;font-weight:500;margin:0 0 30px}.showcase-index h2 em{font-family:'Newsreader Variable',Georgia,serif;font-weight:400}.showcase-index>div>span{display:block;max-width:34ch;font-size:15px;line-height:1.6;color:#65716b}.showcase-links>a{display:grid;grid-template-columns:25px 1fr auto;gap:16px;align-items:start;padding:22px 0;border-top:1px solid #cbd0ca}.showcase-links>a>span{font:11px 'JetBrains Mono Variable',monospace;color:#65716b;padding-top:4px}.showcase-links strong{font-size:19px;font-weight:500;letter-spacing:-.03em}.showcase-links p{font-size:12px;line-height:1.5;margin:8px 0 0;color:#65716b}.showcase-links b{font-size:10px;font-weight:400;margin-top:6px;white-space:nowrap}footer{display:flex;justify-content:space-between;border-top:1px solid #cbd0ca;padding:24px 0 35px;font-size:12px;color:#65716b}
  @media(max-width:1000px){.room-intro>div{position:static;margin-top:32px;max-width:500px}.directions{gap:18px}.direction-title{align-items:flex-start}.direction-title h2{font-size:22px}.swatches{gap:2px}.swatches i{width:10px;height:10px}.showcase-index{gap:40px}.showcase-links>a{grid-template-columns:20px 1fr}.showcase-links b{grid-column:2;margin-top:0}}
  @media(max-width:700px){.design-room{padding:0 20px}.design-room header>span{display:none}.room-intro{padding-top:44px}.room-intro h1{font-size:64px}.view-switch>span{display:none}.directions{grid-template-columns:1fr;gap:44px}.direction-title h2{font-size:29px}.miniature{aspect-ratio:1.4}.direction>p{max-width:none}.showcase-index{grid-template-columns:1fr;gap:30px;margin-top:50px;padding:50px 0}footer{gap:20px;font-size:11px}.room-intro>div{font-size:15px}}

  .room-intro{padding:44px 0 36px}.room-intro h1{font-size:clamp(50px,5.2vw,78px)}.room-intro>div{bottom:40px}.miniature{padding:15px 18px;background:#f5f3ee;color:#1d2928}.mini-nav{display:flex;justify-content:space-between;border-bottom:1px solid #68736788;padding-bottom:12px;font-size:7px}.mini-nav i{color:#173dc9;font-style:normal}.mini-portfolio>p,.mini-blog>p{font-size:7px;margin:22px 0 13px}.miniature h4{font-size:clamp(24px,2.6vw,40px);line-height:.95;letter-spacing:-.07em;font-weight:500;margin:0 0 22px}.miniature h4 em{font-family:'Newsreader Variable',serif;font-weight:400}.mini-work{background:#173dc9;color:#fff;padding:14px 18px 0}.mini-work>span{font-size:7px;display:block;margin-bottom:12px}.mini-work img{width:100%;height:auto;display:block}.mini-2{background:#fafafa;color:#1a1a1a}.mini-2 h4{font-family:'Newsreader Variable',serif;letter-spacing:-.035em;font-size:40px}.mini-2 .mini-description{font-size:9px;line-height:1.5;margin:0 0 22px;color:#66706b}.mini-2 .mini-work{background:#e7e2f3;color:#352d4c}.mini-3{background:#14201d;color:#edf1e4}.mini-3 h4{font-size:clamp(30px,3vw,46px)}.mini-3 h4 em{font-family:'Geist Variable',sans-serif;font-style:normal;color:#d5ed89}.mini-3 .mini-nav i{color:#d5ed89}.mini-3 .mini-work{background:#a9b69c;color:#172b22}.mini-post{padding:12px 0;border-top:1px solid #86908466;display:grid;grid-template-columns:65px 1fr;gap:12px}.mini-post span{font-size:7px;opacity:.7}.mini-post strong{font-size:12px;line-height:1.2;font-weight:500;letter-spacing:-.025em}[data-mini-portfolio][hidden],[data-mini-blog][hidden]{display:none}
  @media(max-width:700px){.miniature h4,.mini-3 h4{font-size:39px}.room-intro>div{position:static}.mini-post strong{font-size:14px}}
  .mini-4{background:#f8f4e9;color:#18213a}.mini-4 .mini-nav i{color:#0024cc}.mini-4 .mini-work{background:#0024cc}.mini-4 h4 em{color:#0024cc}.mini-5{background:#f4f8f5;color:#0d2b52}.mini-5 .mini-work{background:#0d2b52;color:#fff}.mini-5 .mini-nav i{color:#0d2b52}.mini-5 h4 em{color:#245b68}.palette-credit{font-size:12px;line-height:1.6;color:#65716b;margin:0 0 30px}.palette-credit a{text-decoration:underline}
</style>

---
// Self-hosted fonts
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/geist';

import ProjectPreview from '../../../components/ProjectPreview.astro';
import { projects } from '../../../data/projects';
import { site, profile, contact } from '../../../data/site';
import iconSprite from '../../../assets/icons.svg?raw';

const experienceProjects = projects.filter(p => p.category === 'Experience');
const productProjects = projects.filter(p => p.category === 'Product');
const openSourceProjects = projects.filter(p => p.category === 'Open source');
const experimentProjects = projects.filter(p => p.category === 'Experiment');

const pageTitle = `${profile.name} · ${profile.role}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content="Full-stack engineer who ships AI products end to end: the web and mobile apps and the backend that keeps them running." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="color-scheme" content="light dark" />
</head>
<body>
  <Fragment set:html={iconSprite} />

  <nav class="site-nav">
    <a href="/designs" class="nav-back">← All designs</a>
    <button data-theme-toggle aria-label="Toggle theme">
      <svg width="18" height="18"><use data-theme-icon href="#i-moon"></use></svg>
    </button>
  </nav>

  <main>
  <header class="hero">
    <div class="hero-intro">
      <p class="overline">Full-stack software engineer</p>
      <h1>Tomas Brasca</h1>
      <p class="lead">
        Building AI products from idea to production. Web and mobile interfaces, backend systems that scale, and the infrastructure that keeps them running.
      </p>
    </div>
    <div class="hero-meta">
      <div class="meta-item">
        <span class="label">Based in</span>
        <span class="value">Rosario, Argentina (UTC−3)</span>
      </div>
      <div class="meta-item">
        <span class="label">Experience</span>
        <span class="value">5+ years building products</span>
      </div>
      <div class="meta-item">
        <span class="label">Contact</span>
        <span class="value"><a href="mailto:tomibrasca97@gmail.com">tomibrasca97@gmail.com</a></span>
      </div>
    </div>
  </header>

  <section class="featured">
    <h2>Selected work</h2>

    <article class="featured-project highlight">
      <div class="project-image">
        {experienceProjects[1]?.image ? (
          <img src={experienceProjects[1].image} alt={`${experienceProjects[1].name} screenshot`} loading="lazy" />
        ) : (
          <div class="placeholder dex">
            <div class="dex-chrome">
              <aside>
                <b>dex</b>
                <span>People</span>
                <span>Reminders</span>
                <span>Notes</span>
              </aside>
              <div class="dex-content">
                <small>Your relationships, thoughtfully kept.</small>
                <h4>Stay in touch</h4>
                <div class="contact-card">
                  <i>JL</i>
                  <div>
                    <b>Jamie Lee</b>
                    <span>Coffee next week</span>
                  </div>
                </div>
                <div class="contact-card">
                  <i>AC</i>
                  <div>
                    <b>Alex Chen</b>
                    <span>New role check-in</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
      <div class="project-content">
        <span class="category">{experienceProjects[1]?.category}</span>
        <h3><a href="/showcase/dex">{experienceProjects[1]?.name}</a></h3>
        <p class="description">{experienceProjects[1]?.description}</p>
        <p class="stack">{experienceProjects[1]?.stack}</p>
        <div class="project-links">
          {experienceProjects[1]?.website && (
            <a href={experienceProjects[1].website} class="btn-link">Visit site →</a>
          )}
          {experienceProjects[1]?.caseStudy && (
            <a href={experienceProjects[1].caseStudy} class="btn-link">Case study →</a>
          )}
        </div>
      </div>
    </article>

    <article class="featured-project highlight">
      <div class="project-image">
        {experienceProjects[0]?.image ? (
          <img src={experienceProjects[0].image} alt={`${experienceProjects[0].name} screenshot`} loading="lazy" />
        ) : (
          <div class="placeholder mint">
            <div class="mint-hero">
              <small>Wireless, simplified.</small>
              <h4>A fresh take<br />on mobile.</h4>
              <div class="mint-card">
                <small>Made for you</small>
                <b>Unlimited</b>
                <span>Talk. Text. Data.</span>
              </div>
            </div>
          </div>
        )}
      </div>
      <div class="project-content">
        <span class="category">{experienceProjects[0]?.category}</span>
        <h3><a href="/showcase/mint">{experienceProjects[0]?.name}</a></h3>
        <p class="description">{experienceProjects[0]?.description}</p>
        <p class="stack">{experienceProjects[0]?.stack}</p>
        <div class="project-links">
          {experienceProjects[0]?.website && (
            <a href={experienceProjects[0].website} class="btn-link">Visit site →</a>
          )}
          {experienceProjects[0]?.caseStudy && (
            <a href={experienceProjects[0].caseStudy} class="btn-link">Case study →</a>
          )}
        </div>
      </div>
    </article>

    <div class="product-grid">
      {productProjects.slice(0, 3).map(p => (
        <article class="product-card">
          <div class="card-preview">
            {p.image ? (
              <img src={p.image} alt={`${p.name} preview`} loading="lazy" />
            ) : (
              <ProjectPreview project={p} />
            )}
          </div>
          <div class="card-content">
            <h4><a href={`/showcase/${p.id}`}>{p.name}</a></h4>
            <p>{p.description}</p>
            <span class="tech">{p.stack}</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="all-projects">
    <h2>Complete index</h2>

    <div class="project-category">
      <h3>Products</h3>
      <ul class="project-list">
        {productProjects.map(p => (
          <li>
            <a href={`/showcase/${p.id}`}>
              <strong>{p.name}</strong>
              <span>{p.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="project-category">
      <h3>Open source</h3>
      <ul class="project-list">
        {openSourceProjects.map(p => (
          <li>
            <a href={`/showcase/${p.id}`}>
              <strong>{p.name}</strong>
              <span>{p.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="project-category">
      <h3>Experiments</h3>
      <ul class="project-list">
        {experimentProjects.map(p => (
          <li>
            <a href={`/showcase/${p.id}`}>
              <strong>{p.name}</strong>
              <span>{p.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="background">
    <h2>Background</h2>
    <div class="background-grid">
      <div class="background-item">
        <h3>Current role</h3>
        <p><strong>Software Engineer II</strong> at Dex</p>
        <p>CRM features across web and mobile. Multi-model AI routing with task-specific evals across OpenAI, Groq and OpenRouter.</p>
      </div>
      <div class="background-item">
        <h3>Previous experience</h3>
        <p><strong>Backend Engineer</strong> at Mint Mobile</p>
        <p>E-commerce APIs for a platform with 2–3 million subscribers at the time. Inventory, checkout and services around a WordPress order system.</p>
      </div>
      <div class="background-item">
        <h3>Competitive programming</h3>
        <p>ICPC South America finalist. 1st place at GTS algorithmic trading competition.</p>
      </div>
      <div class="background-item">
        <h3>Writing & research</h3>
        <p><a href="/designs/candidate-2/blog">Blog posts</a> on AI systems, algorithms, and technical decision-making.</p>
      </div>
    </div>
  </section>

  <section class="conversational" id="playground">
    <div class="conversational-content">
      <h2>Ask about my work</h2>
      <p class="lead">An agent can answer questions about projects, technical decisions, and show structured cards and comparisons.</p>
      <a href="/#playground" class="btn-primary">Try the conversational interface</a>
      <p class="note">Available on the main site — see <a href="/work/flagship">how it's built</a></p>
    </div>
  </section>

  </main>
  <footer class="site-footer">
    <div class="footer-content">
      <div>
        <p><strong>Tomas Brasca</strong></p>
        <p>Full-stack software engineer</p>
      </div>
      <div class="footer-links">
        <a href="mailto:tomibrasca97@gmail.com">Email</a>
        <a href="/cv.pdf">Resume</a>
        <a href="https://github.com/soundOfff">GitHub</a>
        <a href="https://www.linkedin.com/in/tomasbrasca">LinkedIn</a>
      </div>
    </div>
  </footer>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --font-sans: 'Geist Variable', system-ui, sans-serif;
      --font-serif: 'Newsreader Variable', Georgia, serif;
      --color-bg: #fafafa;
      --color-text: #1a1a1a;
      --color-text-muted: #666;
      --color-border: #e0e0e0;
      --color-accent: #2563eb;
      --color-accent-hover: #1d4ed8;
      --spacing-unit: 8px;
    }

    :root[data-theme="dark"] {
      --color-bg: #0f0f0f;
      --color-text: #e8e8e8;
      --color-text-muted: #999;
      --color-border: #2a2a2a;
      --color-accent: #60a5fa;
      --color-accent-hover: #93c5fd;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-sans);
      background: var(--color-bg);
      color: var(--color-text);
      line-height: 1.6;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
    }

    .site-nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: calc(var(--spacing-unit) * 2) calc(var(--spacing-unit) * 4);
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      z-index: 100;
    }

    .nav-back {
      color: var(--color-text-muted);
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s;
    }

    .nav-back:hover {
      color: var(--color-text);
    }

    button[data-theme-toggle] {
      background: none;
      border: none;
      color: var(--color-text);
      cursor: pointer;
      padding: 8px;
      display: flex;
      align-items: center;
    }

    .hero {
      max-width: 1200px;
      margin: 0 auto;
      padding: calc(var(--spacing-unit) * 15) calc(var(--spacing-unit) * 4) calc(var(--spacing-unit) * 10);
    }

    .hero-intro {
      margin-bottom: calc(var(--spacing-unit) * 8);
    }

    .overline {
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-text-muted);
      margin-bottom: calc(var(--spacing-unit) * 2);
    }

    h1 {
      font-family: var(--font-serif);
      font-size: clamp(48px, 8vw, 96px);
      font-weight: 500;
      line-height: 1;
      margin-bottom: calc(var(--spacing-unit) * 4);
      letter-spacing: -0.02em;
    }

    .lead {
      font-size: clamp(18px, 2.5vw, 24px);
      line-height: 1.5;
      max-width: 42ch;
      color: var(--color-text-muted);
    }

    .hero-meta {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: calc(var(--spacing-unit) * 4);
      padding-top: calc(var(--spacing-unit) * 6);
      border-top: 1px solid var(--color-border);
    }

    .meta-item {
      display: flex;
      flex-direction: column;
      gap: calc(var(--spacing-unit));
    }

    .meta-item .label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-text-muted);
    }

    .meta-item .value {
      font-size: 16px;
      color: var(--color-text);
    }

    .meta-item a {
      color: var(--color-accent);
      text-decoration: none;
    }

    section {
      max-width: 1200px;
      margin: 0 auto;
      padding: calc(var(--spacing-unit) * 12) calc(var(--spacing-unit) * 4);
    }

    h2 {
      font-family: var(--font-serif);
      font-size: clamp(36px, 5vw, 56px);
      font-weight: 500;
      margin-bottom: calc(var(--spacing-unit) * 8);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .featured-project {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: calc(var(--spacing-unit) * 6);
      margin-bottom: calc(var(--spacing-unit) * 12);
      align-items: center;
    }

    .project-image {
      aspect-ratio: 4 / 3;
      background: var(--color-border);
      border-radius: 8px;
      overflow: hidden;
    }

    .project-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .placeholder {
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: calc(var(--spacing-unit) * 4);
    }

    .dex {
      background: #eae5f8;
      color: #1a1a1a;
    }

    .dex-chrome {
      display: grid;
      grid-template-columns: 100px 1fr;
      background: #fff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(0,0,0,0.1);
      width: 100%;
      max-width: 420px;
      min-height: 280px;
    }

    .dex-chrome aside {
      background: #f4f1fa;
      padding: calc(var(--spacing-unit) * 3);
      display: flex;
      flex-direction: column;
      gap: calc(var(--spacing-unit) * 2);
    }

    .dex-chrome b {
      font-size: 20px;
      color: #7854ad;
      margin-bottom: calc(var(--spacing-unit));
    }

    .dex-chrome span {
      font-size: 13px;
      color: #666;
    }

    .dex-content {
      padding: calc(var(--spacing-unit) * 3);
    }

    .dex-content small {
      font-size: 11px;
      color: #999;
    }

    .dex-content h4 {
      font-size: 22px;
      margin: calc(var(--spacing-unit)) 0 calc(var(--spacing-unit) * 2);
    }

    .contact-card {
      display: flex;
      align-items: center;
      gap: calc(var(--spacing-unit) * 1.5);
      padding: calc(var(--spacing-unit) * 1.5) 0;
      border-top: 1px solid #eee;
    }

    .contact-card i {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #e8def3;
      display: grid;
      place-items: center;
      font-style: normal;
      font-size: 12px;
      color: #7854ad;
    }

    .contact-card b {
      display: block;
      font-size: 14px;
      font-weight: 500;
    }

    .contact-card span {
      display: block;
      font-size: 12px;
      color: #999;
    }

    .mint {
      background: #e7f1ea;
      color: #405d46;
    }

    .mint-hero {
      background: #fff;
      padding: calc(var(--spacing-unit) * 4);
      border-radius: 8px;
      max-width: 420px;
    }

    .mint-hero small {
      font-size: 12px;
    }

    .mint-hero h4 {
      font-size: 36px;
      line-height: 1;
      font-weight: 800;
      margin: calc(var(--spacing-unit) * 2) 0;
      letter-spacing: -0.03em;
      color: #405d46;
    }

    .mint-card {
      background: #f5f5f5;
      padding: calc(var(--spacing-unit) * 2);
      border-radius: 8px;
      margin-top: calc(var(--spacing-unit) * 3);
    }

    .mint-card small {
      font-size: 11px;
      display: block;
      color: #999;
    }

    .mint-card b {
      display: block;
      font-size: 20px;
      margin: calc(var(--spacing-unit) / 2) 0;
    }

    .mint-card span {
      font-size: 13px;
      color: #666;
    }

    .category {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-text-muted);
    }

    .project-content h3 {
      font-size: 32px;
      font-weight: 600;
      margin: calc(var(--spacing-unit) * 2) 0;
      line-height: 1.2;
    }

    .project-content h3 a {
      color: var(--color-text);
      text-decoration: none;
    }

    .project-content h3 a:hover {
      color: var(--color-accent);
    }

    .description {
      font-size: 18px;
      line-height: 1.6;
      color: var(--color-text);
      margin-bottom: calc(var(--spacing-unit) * 2);
    }

    .stack {
      font-size: 14px;
      color: var(--color-text-muted);
      margin-bottom: calc(var(--spacing-unit) * 3);
    }

    .project-links {
      display: flex;
      gap: calc(var(--spacing-unit) * 3);
    }

    .btn-link {
      color: var(--color-accent);
      text-decoration: none;
      font-weight: 500;
      font-size: 16px;
      transition: color 0.2s;
    }

    .btn-link:hover {
      color: var(--color-accent-hover);
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: calc(var(--spacing-unit) * 4);
      margin-top: calc(var(--spacing-unit) * 8);
    }

    .product-card {
      border: 1px solid var(--color-border);
      border-radius: 8px;
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .product-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    }

    .card-preview {
      aspect-ratio: 16 / 9;
      background: var(--color-border);
      overflow: hidden;
    }

    .card-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .preview-stub {
      height: 100%;
      display: grid;
      place-items: center;
      font-size: 48px;
      font-weight: 700;
      color: var(--color-text-muted);
      background: linear-gradient(135deg, var(--color-border), var(--color-bg));
    }

    .card-content {
      padding: calc(var(--spacing-unit) * 3);
    }

    .card-content h4 {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: calc(var(--spacing-unit));
    }

    .card-content h4 a {
      color: var(--color-text);
      text-decoration: none;
    }

    .card-content h4 a:hover {
      color: var(--color-accent);
    }

    .card-content p {
      font-size: 14px;
      line-height: 1.5;
      color: var(--color-text-muted);
      margin-bottom: calc(var(--spacing-unit) * 2);
    }

    .tech {
      font-size: 12px;
      color: var(--color-text-muted);
    }

    .all-projects {
      background: var(--color-bg);
      border-top: 1px solid var(--color-border);
    }

    .project-category {
      margin-bottom: calc(var(--spacing-unit) * 8);
    }

    .project-category h3 {
      font-size: 24px;
      font-weight: 600;
      margin-bottom: calc(var(--spacing-unit) * 3);
      color: var(--color-text-muted);
    }

    .project-list {
      list-style: none;
      display: grid;
      gap: calc(var(--spacing-unit) * 2);
    }

    .project-list li a {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: calc(var(--spacing-unit) * 3);
      padding: calc(var(--spacing-unit) * 3);
      border: 1px solid var(--color-border);
      border-radius: 6px;
      text-decoration: none;
      color: var(--color-text);
      transition: background 0.2s, border-color 0.2s;
    }

    .project-list li a:hover {
      background: var(--color-border);
      border-color: var(--color-text-muted);
    }

    .project-list strong {
      font-size: 16px;
      font-weight: 600;
    }

    .project-list span {
      font-size: 14px;
      color: var(--color-text-muted);
    }

    .background {
      background: var(--color-bg);
    }

    .background-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: calc(var(--spacing-unit) * 6);
    }

    .background-item h3 {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: calc(var(--spacing-unit) * 2);
    }

    .background-item p {
      font-size: 15px;
      line-height: 1.6;
      color: var(--color-text-muted);
      margin-bottom: calc(var(--spacing-unit) * 1.5);
    }

    .background-item a {
      color: var(--color-accent);
      text-decoration: none;
    }

    .conversational {
      background: var(--color-text);
      color: var(--color-bg);
      border-radius: 12px;
      text-align: center;
    }

    .conversational-content {
      max-width: 600px;
      margin: 0 auto;
    }

    .conversational h2 {
      color: var(--color-bg);
    }

    .conversational .lead {
      color: rgba(255, 255, 255, 0.8);
      margin-bottom: calc(var(--spacing-unit) * 4);
    }

    .btn-primary {
      display: inline-block;
      background: var(--color-bg);
      color: var(--color-text);
      padding: calc(var(--spacing-unit) * 2) calc(var(--spacing-unit) * 4);
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      font-size: 16px;
      transition: opacity 0.2s;
      margin-bottom: calc(var(--spacing-unit) * 2);
    }

    .btn-primary:hover {
      opacity: 0.9;
    }

    .note {
      font-size: 14px;
      color: rgba(255, 255, 255, 0.6);
    }

    .note a {
      color: rgba(255, 255, 255, 0.8);
    }

    .site-footer {
      border-top: 1px solid var(--color-border);
      padding: calc(var(--spacing-unit) * 6) calc(var(--spacing-unit) * 4);
    }

    .footer-content {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: start;
      gap: calc(var(--spacing-unit) * 4);
    }

    .footer-content p {
      font-size: 14px;
      color: var(--color-text-muted);
      margin-bottom: calc(var(--spacing-unit) / 2);
    }

    .footer-links {
      display: flex;
      gap: calc(var(--spacing-unit) * 3);
    }

    .footer-links a {
      color: var(--color-text-muted);
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s;
    }

    .footer-links a:hover {
      color: var(--color-text);
    }

    @media (max-width: 768px) {
      .featured-project {
        grid-template-columns: 1fr;
        gap: calc(var(--spacing-unit) * 4);
      }

      .project-list li a {
        grid-template-columns: 1fr;
        gap: calc(var(--spacing-unit) * 2);
      }

      .footer-content {
        flex-direction: column;
      }

      .product-grid {
        grid-template-columns: 1fr;
      }

      .dex-chrome {
        grid-template-columns: 80px 1fr;
        min-height: 240px;
      }
    }
    .hero{padding-top:110px;padding-bottom:30px}.hero-intro{margin-bottom:32px}.hero-meta{padding-top:24px}.featured{padding-top:32px}.featured>h2{margin-bottom:36px}.conversational .lead,.note,.note a{color:inherit;opacity:.8}.card-preview :global(.product-preview){height:100%;margin:0}
    :focus-visible{outline:2px solid var(--color-accent);outline-offset:4px}
  </style>

  <script is:inline define:vars={{ key: `${site.themeKey}:editorial-preview` }}>
    (function () {
      const root = document.documentElement;
      const current = () =>
        root.dataset.theme ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const apply = (theme) => {
        root.dataset.theme = theme;
        document.querySelectorAll('[data-theme-icon]').forEach((u) => {
          u.setAttribute('href', theme === 'dark' ? '#i-sun' : '#i-moon');
        });
      };
      let saved;
      try { saved = localStorage.getItem(key); } catch {}
      apply(saved === 'dark' ? 'dark' : 'light');
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem(key, next);
          } catch {}
          apply(next);
        });
      });
    })();
  </script>
</body>
</html>

---
import { getCollection, render } from 'astro:content';
import { Badge } from 'editorial-ui';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/reading.css';

export const getStaticPaths = (async () => {
  const studies = await getCollection('work', ({ data }) => !data.draft);
  return studies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const studies = await getCollection('work', ({ data }) => !data.draft);
const position = studies.findIndex((study) => study.id === entry.id);
const previous = studies[position - 1];
const next = studies[position + 1];
---

<BaseLayout
  title={`${entry.data.title} · Tomas Brasca`}
  description={entry.data.description}
  type="article"
  articleKind="Article"
  headline={entry.data.title}
>
  <main id="main" class="reading-shell shell">
    <div class="article-column">
      <header class="page-head">
        <p class="eyebrow">// <b>case study</b> · {entry.data.n}</p>
        <h1>{entry.data.title}</h1>
        <p class="dek">{entry.data.description}</p>
        <div class="meta">
          <span>{entry.data.year}</span>
          <span>·</span>
          <span>{entry.data.stack}</span>
          <Badge variant={entry.data.code ? 'success' : 'info'}>
            {entry.data.code ? 'real code' : 'narrative'}
          </Badge>
        </div>
      </header>

      {
        sections.length > 2 && (
          <details class="article-contents">
            <>
              <summary>
                In this case study <span>{sections.length} sections</span>
              </summary>
              <nav aria-label="Case study contents">
                <ol>
                  {sections.map((heading) => (
                    <li>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            </>
          </details>
        )
      }
      <article class="prose">
        <Content />
      </article>
    </div>

    <nav class="reading-neighbors article-column" aria-label="More case studies">
      {
        previous && (
          <a href={`/work/${previous.id}`}>
            <span>← Previous case study</span>
            {previous.data.title}
          </a>
        )
      }{
        next && (
          <a href={`/work/${next.id}`}>
            <span>Next case study →</span>
            {next.data.title}
          </a>
        )
      }
    </nav>
    <a class="article-back" href="/#index">← All projects</a>
  </main>
</BaseLayout>

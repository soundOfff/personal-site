---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromptPracticeDemo from '../../islands/PromptPracticeDemo';
import { projects, workSlug } from '../../data/projects';
import stories from '../../data/project-stories.json';

// Every project gets a page. Projects with a written case study render it below the story.
export const getStaticPaths = (async () => {
  const studies = await getCollection('work', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: workSlug(project) },
    props: { project, study: studies.find((entry) => entry.id === workSlug(project)) },
  }));
}) satisfies GetStaticPaths;

const { project, study } = Astro.props;
const story = stories[project.id as keyof typeof stories];
const Content = study ? (await render(study)).Content : null;
const next = projects[(projects.indexOf(project) + 1) % projects.length];
const website = project.website === '#playground' ? '/#playground' : project.website;
---

<BaseLayout
  title={`${project.name} · Tomas Brasca`}
  description={project.description}
  type="article"
  articleKind="Article"
  headline={project.name}
>
  <main id="main" tabindex="-1">
    <header class="detail-hero" data-on-blue>
      <canvas class="detail-cave" data-cave={project.id} data-bloom aria-hidden="true"></canvas>
      <div class="shell">
        <a class="back" href="/#index">← All projects</a>
        <p class="eyebrow">{project.category}{study && ` / ${study.data.year}`}</p>
        <h1>{project.name}</h1>
        <p class="subtitle">{story.subtitle}</p>
        <p class="detail-lede">{project.description}</p>
        <div class="detail-info">
          <div><span class="meta">Contribution</span><p>{story.role}</p></div>
          <div>
            <span class="meta">Built with</span><p>{project.stack.split(' · ').join(' / ')}</p>
          </div>
          <div><span class="meta">Status</span><p>{story.status}</p></div>
          <div class="detail-actions">
            {
              project.id === 'a2ui' && (
                <a class="button primary" href="/#playground">
                  Open the playground
                </a>
              )
            }
            {
              project.id === 'letterboxd' && (
                <a
                  class="button"
                  href="/previews/letterboxd/sample-story.pdf"
                  target="_blank"
                  rel="noopener"
                >
                  Open the full booklet
                </a>
              )
            }
            {
              website && project.id !== 'a2ui' && (
                <a class="button" href={website} target="_blank" rel="noopener">
                  Visit project
                </a>
              )
            }
            {
              project.source && (
                <a class="button" href={project.source} target="_blank" rel="noopener">
                  View source
                </a>
              )
            }
          </div>
        </div>
      </div>
    </header>

    <section class="shell detail-media" aria-label={`${project.name} in action`}>
      {
        project.id === '60-seconds' ? (
          <PromptPracticeDemo client:visible />
        ) : story.demo ? (
          <figure class="demo-video">
            <video
              controls
              muted
              playsinline
              preload="metadata"
              poster={project.image ?? undefined}
            >
              <source src={story.demo} type="video/mp4" />
              <a href={story.demo}>Download the product demonstration</a>
            </video>
            <figcaption>
              Actual extension recording / Select a component, capture it, open the library.
            </figcaption>
          </figure>
        ) : story.media.length ? (
          <div class="gallery">
            {story.media.map((media, i) => (
              <figure>
                <img
                  src={media.src}
                  alt={media.caption}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <figcaption>{media.caption}</figcaption>
              </figure>
            ))}
          </div>
        ) : (
          <div class="detail-cover">
            <canvas class="generated-cover" data-cave={`${project.id}-cover`} aria-hidden="true" />
            <span class="generated-title">{project.name}</span>
          </div>
        )
      }
      {story.note && <p class="media-note">{story.note}</p>}
    </section>

    <section class="shell story" aria-labelledby="story-title">
      <div>
        <p class="eyebrow">Behind the interface</p>
        <h2 id="story-title">What I worked on.</h2>
      </div>
      <div>
        <p class="lede">{story.story}</p>
        <ul>{story.contribution.map((item) => <li>{item}</li>)}</ul>
      </div>
    </section>
    <section class="shell story" aria-labelledby="flow-title">
      <div>
        <p class="eyebrow">The product flow</p>
        <h2 id="flow-title">From input to something useful.</h2>
      </div>
      <ol>{story.flow.map((step) => <li>{step}</li>)}</ol>
    </section>

    {
      Content && (
        <>
          <div class="shell case-study-label">
            <p class="eyebrow">The engineering case study</p>
          </div>
          <article class="reading" data-progress>
            <Content />
          </article>
        </>
      )
    }

    <div class="shell section">
      <a class="journal-cta" href={`/work/${workSlug(next)}`}>Next: {next.name} →</a>
    </div>
  </main>
</BaseLayout>

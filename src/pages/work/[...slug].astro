---
import { getCollection, render } from 'astro:content';
import { Badge } from 'editorial-ui';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Footer from '../../components/Footer.astro';

export const getStaticPaths = (async () => {
  const studies = await getCollection('work');
  return studies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} — Tomas Brasca`} description={entry.data.description}>
  <div class="sheet">
    <div class="topbar">
      <a class="back" href="/#work"><Icon name="i-arrow-l" size={13} />work index</a>
      <button class="btn-icon btn-quiet" data-theme-toggle aria-label="Toggle theme" type="button">
        <svg
          width="15"
          height="15"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <use href="#i-moon" data-theme-icon></use>
        </svg>
      </button>
    </div>

    <header class="page-head">
      <p class="eyebrow">// <b>case study</b> · {entry.data.n}</p>
      <h1>{entry.data.title}</h1>
      <p class="dek">{entry.data.description}</p>
      <div class="meta">
        <span>{entry.data.year}</span>
        <span>·</span>
        <span>{entry.data.stack}</span>
        <Badge variant={entry.data.code ? 'success' : 'info'}>
          {entry.data.code ? 'real code' : 'narrative'}
        </Badge>
      </div>
    </header>

    <article class="prose">
      <Content />
    </article>

    <button class="back-to-top" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })" aria-label="Back to top" type="button">
      <Icon name="i-arrow-u" size={14} />
    </button>

    <script is:inline>
      (function() {
        const btn = document.querySelector('.back-to-top');
        if (btn) {
          // Check on load in case the user reloads halfway down
          if (window.scrollY > window.innerHeight) {
            btn.classList.add('is-visible');
          }
          window.addEventListener('scroll', () => {
            if (window.scrollY > window.innerHeight) {
              btn.classList.add('is-visible');
            } else {
              btn.classList.remove('is-visible');
            }
          }, { passive: true });
        }
      })();
    </script>

    <Footer />
  </div>
</BaseLayout>

---
import { render } from 'astro:content';
import { publicPosts } from '../../lib/discovery/documents';
import type { GetStaticPaths } from 'astro';
import BlogLayout from '../../layouts/BlogLayout.astro';

export const getStaticPaths = (async () => {
  const posts = await publicPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2);
const date = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BlogLayout
  title={`${post.data.title} · Tomas Brasca`}
  description={post.data.description}
  type="article"
  headline={post.data.title}
  markdownPath={`/blog/${post.id}.md`}
  publishedTime={post.data.date.toISOString()}
>
  <article class="article-column" aria-labelledby="article-title">
    <a class="article-back" href="/blog">← All writing</a>
    <header class="article-head">
      <p class="writing-eyebrow">{post.data.pillar}</p>
      <h1 id="article-title">{post.data.title}</h1>
      <p class="article-dek">{post.data.description}</p>
      <div class="article-meta">
        <span>Tomas Brasca</span>
        <time datetime={post.data.date.toISOString()}>{date.format(post.data.date)}</time>
        <span>{post.data.readingTime} read</span>
      </div>
    </header>
    {
      sections.length > 2 && (
        <details class="article-contents">
          <summary>
            In this article <span>{sections.length} sections</span>
          </summary>
          <nav aria-label="Article contents">
            <ol>
              {sections.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )
    }
    <div class="prose"><Content /></div>
    <footer class="article-foot">
      {
        post.data.tags.length > 0 && (
          <nav class="article-tags" aria-label="Article topics">
            <span>Topics</span>
            {post.data.tags.map((tag: string) => (
              <a href={`/blog?tag=${encodeURIComponent(tag)}`}>{tag.replaceAll('-', ' ')}</a>
            ))}
          </nav>
        )
      }
      <nav class="reading-end" aria-label="After reading">
        <a href="/blog">← All writing</a>
        <a href="mailto:tomibrasca97@gmail.com">Discuss this article ↗</a>
      </nav>
    </footer>
  </article>
  <script is:inline>
    document.querySelectorAll('.prose pre, .prose table').forEach((element) => {
      element.setAttribute('tabindex', '0');
      if (element.tagName === 'PRE') {
        element.setAttribute('role', 'region');
      }
      element.setAttribute(
        'aria-label',
        element.tagName === 'PRE' ? 'Code example' : 'Article table',
      );
    });
  </script>
</BlogLayout>

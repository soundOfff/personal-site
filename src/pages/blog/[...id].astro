---
import { getCollection, render } from 'astro:content';
import { Badge } from 'editorial-ui';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Footer from '../../components/Footer.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout
  title={`${post.data.title} · Tomas Brasca`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date.toISOString()}
>
  <div class="sheet">
    <div class="topbar">
      <a class="back" href="/blog"><Icon name="i-arrow-l" size={13} />all writing</a>
      <button class="btn-icon btn-quiet" data-theme-toggle aria-label="Toggle theme" type="button">
        <svg
          width="15"
          height="15"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <use href="#i-moon" data-theme-icon></use>
        </svg>
      </button>
    </div>

    <header class="page-head">
      <p class="eyebrow">// <b>{post.data.pillar}</b></p>
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
      <div class="meta">
        <span>{iso(post.data.date)}</span>
        <span>·</span>
        <span>{post.data.readingTime}</span>
        <div class="ptags">
          {post.data.tags.map((t) => <Badge variant="info">#{t}</Badge>)}
        </div>
      </div>
    </header>

    <article class="prose">
      <Content />
    </article>

    <button class="back-to-top" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })" aria-label="Back to top" type="button">
      <Icon name="i-arrow-u" size={14} />
    </button>

    <script is:inline>
      (function() {
        const btn = document.querySelector('.back-to-top');
        if (btn) {
          // Check on load in case the user reloads halfway down
          if (window.scrollY > window.innerHeight) {
            btn.classList.add('is-visible');
          }
          window.addEventListener('scroll', () => {
            if (window.scrollY > window.innerHeight) {
              btn.classList.add('is-visible');
            } else {
              btn.classList.remove('is-visible');
            }
          }, { passive: true });
        }
      })();
    </script>

    <Footer />
  </div>
</BaseLayout>

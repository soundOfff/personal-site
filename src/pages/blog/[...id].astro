---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BlogLayout from '../../layouts/BlogLayout.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2);
const date = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BlogLayout
  title={`${post.data.title} · Tomas Brasca`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date.toISOString()}
>
  <div class="article-column">
    <a class="article-back" href="/blog">← All writing</a>
    <header class="article-head">
      <p class="writing-eyebrow">{post.data.pillar}</p>
      <h1>{post.data.title}</h1>
      <p class="article-dek">{post.data.description}</p>
      <div class="article-meta">
        <time datetime={post.data.date.toISOString()}>{date.format(post.data.date)}</time><span
          >{post.data.readingTime} read</span
        ><span>Tomas Brasca</span>
      </div>
    </header>
    {
      sections.length > 2 && (
        <details class="article-contents">
          <>
            <summary>In this article</summary>
            <ol>
              {sections.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </>
        </details>
      )
    }
    <article class="prose"><Content /></article>
    <nav class="reading-end" aria-label="After reading">
      <a href="/blog">← More writing</a><a href="mailto:tomibrasca97@gmail.com"
        >Discuss this article ↗</a
      >
    </nav>
  </div>
</BlogLayout>

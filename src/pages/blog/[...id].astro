---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { publicPosts } from '../../lib/discovery/documents';
import { pageUrl } from '../../lib/site-origin';

export const getStaticPaths = (async () => {
  const posts = await publicPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2);
// Three related posts, ranked by shared tags.
const related = (await publicPosts())
  .filter((other) => other.id !== post.id)
  .map((other) => ({
    other,
    score: other.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(({ other }) => other);
const date = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const published = date.format(post.data.date);
---

<BaseLayout
  title={`${post.data.title} · Tomas Brasca`}
  description={post.data.description}
  type="article"
  articleKind="BlogPosting"
  headline={post.data.title}
  markdownPath={`/blog/${post.id}.md`}
  publishedTime={post.data.date.toISOString()}
>
  <main id="main" tabindex="-1">
    <div class="shell">
      <header class="article-top">
        <a class="back" href="/blog">← Back to the journal</a>
        <p class="eyebrow">{post.data.pillar}</p>
        <h1>{post.data.title}</h1>
        <p class="dek">{post.data.description}</p>
        <div class="article-meta">
          <span>Tomas Brasca</span>
          <time datetime={post.data.date.toISOString()}>{published}</time>
          <span>{post.data.readingTime} read</span>
        </div>
      </header>
    </div>
    <article class="reading" data-progress>
      {
        sections.length > 2 && (
          <details class="toc">
            <summary>
              In this article <span class="muted">/ {sections.length} sections</span>
            </summary>
            <ol>
              {sections.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }
      <Content />
    </article>
    <section class="post-close" aria-label="After reading">
      <div class="shell">
        <div class="post-close-top">
          <div>
            <span class="meta">{published} / {post.data.readingTime} read</span>
            <h3>A thought worth keeping?</h3>
            <p>{post.data.tags.map((tag) => tag.replaceAll('-', ' ')).join(' / ')}</p>
            <button
              class="button"
              type="button"
              data-copy={pageUrl(`/blog/${post.id}`)}
              data-copy-label="Copy article link"
            >
              Copy article link <span aria-hidden="true">↗</span>
            </button>
          </div>
          <div>
            <p class="eyebrow">Written by Tomas Brasca</p>
            <h3>Curious by default.</h3>
            <p>
              Full-stack engineer in Rosario. I build web and mobile products, the APIs behind them,
              and AI systems that make them useful.
            </p>
            <a class="small-link" href="mailto:tomibrasca97@gmail.com"
              >Continue the conversation ↗</a
            >
          </div>
        </div>
        <h2 class="related-title">Follow another thread.</h2>
        <div class="post-grid">
          {related.map((other) => <PostCard post={other} />)}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

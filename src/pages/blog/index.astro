---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixelSigil from '../../components/PixelSigil.astro';
import PostCard from '../../components/PostCard.astro';
import { publicPosts } from '../../lib/discovery/documents';
import { PILLARS } from '../../lib/pillars';

const posts = await publicPosts();
const topics = PILLARS.filter((pillar) => posts.some((post) => post.data.pillar === pillar));
---

<BaseLayout
  title="Journal · Tomas Brasca"
  description="Notes on AI systems, algorithms, and the decisions behind the things I build."
  pageKind="CollectionPage"
  markdownPath="/blog/index.md"
>
  <main id="main" tabindex="-1">
    <div class="shell">
      <header class="page-head">
        <p class="eyebrow">The journal</p>
        <h1>Thinking<br /><span class="ghost">out loud.</span></h1>
        <div class="head-bottom">
          <p>
            Notes on software, algorithms, and the work<br />between an idea and something useful.
          </p>
          <span class="meta">{posts.length} articles / always learning</span>
        </div>
      </header>
      <div class="journal-controls">
        <div class="chips" role="group" aria-label="Journal topics">
          {
            ['All', ...topics].map((topic, i) => (
              <button
                class="chip"
                type="button"
                data-topic={topic}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {topic}
              </button>
            ))
          }
        </div>
        <label class="search-wrap">
          <span class="sr-only">Search article titles</span>
          <span aria-hidden="true">⌕</span>
          <input type="search" id="post-search" placeholder="Find a thought…" autocomplete="off" />
          <button type="button" id="clear-search" aria-label="Clear search" hidden>×</button>
        </label>
      </div>
      <section class="journal-results" aria-label="Articles">
        <div class="results-meta">
          <span class="meta" id="post-count" role="status">{posts.length} articles</span>
          <span class="meta muted">Newest first</span>
        </div>
        <div class="post-grid" id="post-grid">
          {posts.map((post, i) => <PostCard post={post} featured={i < 2} />)}
          <div class="empty" id="post-empty" hidden>
            <PixelSigil star />
            <h2>Nothing matches “<span id="empty-query"></span>”.</h2>
            <p>Try another word, or explore all the articles.</p>
            <button class="button" type="button" id="reset-search">Clear filters</button>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#post-search')!;
  const clear = document.querySelector<HTMLButtonElement>('#clear-search')!;
  const count = document.querySelector<HTMLElement>('#post-count')!;
  const empty = document.querySelector<HTMLElement>('#post-empty')!;
  const emptyQuery = document.querySelector<HTMLElement>('#empty-query')!;
  const cards = [...document.querySelectorAll<HTMLElement>('#post-grid .post-card')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-topic]')];
  let topic = 'All';

  function filter() {
    const query = input.value.trim().toLowerCase();
    const matches = cards.filter(
      (card) =>
        (topic === 'All' || card.dataset.pillar === topic) && card.dataset.title!.includes(query),
    );
    // The two newest posts are featured only in the unfiltered view.
    let featured = topic === 'All' && !query ? 2 : 0;
    cards.forEach((card) => {
      const match = matches.includes(card);
      card.hidden = !match;
      card.classList.toggle('featured', match && featured-- > 0);
    });
    count.textContent = `${matches.length} article${matches.length === 1 ? '' : 's'}`;
    clear.hidden = !input.value;
    empty.hidden = matches.length > 0;
    emptyQuery.textContent = input.value || topic;
  }

  function reset(all: boolean) {
    input.value = '';
    if (all) {
      topic = 'All';
      chips.forEach((chip) =>
        chip.setAttribute('aria-pressed', String(chip.dataset.topic === 'All')),
      );
    }
    filter();
    input.focus();
  }

  input.addEventListener('input', filter);
  clear.addEventListener('click', () => reset(false));
  document.querySelector('#reset-search')!.addEventListener('click', () => reset(true));
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      topic = chip.dataset.topic!;
      chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
      filter();
    }),
  );
</script>

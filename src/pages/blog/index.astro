---
import { publicPosts } from '../../lib/discovery/documents';
import BlogLayout from '../../layouts/BlogLayout.astro';

const posts = await publicPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const date = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BlogLayout
  title="Writing · Tomas Brasca"
  markdownPath="/blog/index.md"
  description="Notes on AI systems, algorithms, and the decisions behind the things I build."
>
  <header class="writing-intro">
    <h1>Writing</h1>
    <p class="writing-description">
      On building AI products, understanding systems, and learning from the work.
    </p>
  </header>
  <div class="writing-tools">
    <p id="writing-count" role="status" aria-atomic="true">{posts.length} articles</p>
    <label for="writing-topic"
      >Topic
      <select id="writing-topic" aria-controls="writing-list">
        <option value="">All topics</option>
        {tags.map((tag) => <option value={tag}>{tag.replaceAll('-', ' ')}</option>)}
      </select>
    </label>
  </div>
  <ol class="writing-list" id="writing-list">
    {
      posts.map((post) => (
        <li data-writing-tags={JSON.stringify(post.data.tags)}>
          <article class="writing-entry">
            <time class="writing-date" datetime={post.data.date.toISOString()}>
              {date.format(post.data.date)}
            </time>
            <div class="writing-entry-text">
              <h2>
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
              <div class="writing-entry-meta">
                <>
                  <span>{post.data.pillar}</span>
                  <span>{post.data.readingTime} read</span>
                </>
              </div>
            </div>
          </article>
        </li>
      ))
    }
  </ol>
  <p class="writing-empty" id="writing-empty" hidden>
    No articles in this topic. <a href="/blog">View all writing</a>.
  </p>
  <script is:inline>
    (() => {
      const select = document.getElementById('writing-topic');
      const entries = [...document.querySelectorAll('[data-writing-tags]')].map((element) => ({
        element,
        tags: JSON.parse(element.dataset.writingTags),
      }));
      const count = document.getElementById('writing-count');
      const empty = document.getElementById('writing-empty');
      const apply = () => {
        let visible = 0;
        entries.forEach(({ element, tags }) => {
          element.hidden = Boolean(select.value) && !tags.includes(select.value);
          if (!element.hidden) visible++;
        });
        count.textContent = `${visible} ${visible === 1 ? 'article' : 'articles'}`;
        empty.hidden = visible !== 0;
      };
      const initial = new URLSearchParams(location.search).get('tag');
      if (initial && ![...select.options].some((option) => option.value === initial)) {
        select.add(new Option(initial.replaceAll('-', ' '), initial));
      }
      select.value = initial || '';
      select.addEventListener('change', () => {
        apply();
        const url = new URL(location.href);
        if (select.value) url.searchParams.set('tag', select.value);
        else url.searchParams.delete('tag');
        history.replaceState(null, '', url);
      });
      apply();
    })();
  </script>
</BlogLayout>

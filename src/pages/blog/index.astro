---
import { getCollection } from 'astro:content';
import { Badge } from 'editorial-ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// flat, tag-organized: collect tags for the filter chips below the dek
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout
  title="Writing — Tomas Brasca"
  description="Build logs, backend & AI systems, algorithms, and startup-engineering notes."
>
  <div class="sheet">
    <div class="topbar">
      <a class="back" href="/"><Icon name="i-arrow-l" size={13} />back to index</a>
      <button class="btn-icon btn-quiet" data-theme-toggle aria-label="Toggle theme" type="button">
        <svg
          width="15"
          height="15"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <use href="/icons.svg#i-moon" data-theme-icon></use>
        </svg>
      </button>
    </div>

    <header class="page-head">
      <p class="eyebrow">// <b>blog</b></p>
      <h1>Writing</h1>
      <p class="dek">
        Four flat, equal pillars — backend &amp; AI systems, algorithms &amp; competitive
        programming, build logs, and startup engineering. Newest first.
      </p>
      {
        allTags.length > 0 && (
          <div class="ptags" role="group" aria-label="Filter posts by tag">
            {allTags.map((t) => (
              <button class="tagbtn" type="button" data-tag={t} aria-pressed="false">
                <Badge>#{t}</Badge>
              </button>
            ))}
          </div>
        )
      }
    </header>

    <div class="posts">
      {
        posts.map((post) => (
          <article class="post" data-tags={post.data.tags.join(',')}>
            <div class="pmeta">
              <span>{iso(post.data.date)}</span>
              <span>·</span>
              <span>{post.data.pillar}</span>
              <span>·</span>
              <span>{post.data.readingTime}</span>
            </div>
            <h2>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h2>
            <p class="pdesc">{post.data.description}</p>
            <div class="ptags">
              {post.data.tags.map((t) => (
                <Badge variant="info">#{t}</Badge>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>

  {/* progressive enhancement: tag chips filter the list (click again to clear) */}
  <script is:inline>
    (() => {
      const chips = document.querySelectorAll('.page-head .tagbtn');
      const posts = document.querySelectorAll('.posts .post');
      let active = null;
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          active = active === chip.dataset.tag ? null : chip.dataset.tag;
          chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.tag === active)));
          posts.forEach((p) => {
            const tags = (p.dataset.tags || '').split(',');
            p.hidden = active !== null && !tags.includes(active);
          });
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  .tagbtn {
    border: 0;
    padding: 0;
    background: none;
    cursor: pointer;
    font: inherit;
  }
  .tagbtn[aria-pressed='false'] :global(*) {
    opacity: 0.9;
  }
  .tagbtn[aria-pressed='true'] {
    outline: 1px solid currentColor;
    outline-offset: 2px;
    border-radius: 999px;
  }
</style>

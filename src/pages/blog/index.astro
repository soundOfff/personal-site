---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const date = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BlogLayout
  title="Writing · Tomas Brasca"
  description="Notes on AI systems, algorithms, and the decisions behind the things I build."
>
  <header class="writing-intro">
    <p class="writing-eyebrow">Notes &amp; essays</p>
    <h1>Writing.</h1>
    <p>On building AI products, understanding systems, and learning from the work.</p>
  </header>
  <div class="writing-tools">
    <p id="writing-count" role="status">{posts.length} articles</p>
    <label for="writing-topic"
      >Topic
      <select id="writing-topic"
        ><option value="">All topics</option>{
          tags.map((tag) => <option value={tag}>{tag.replaceAll('-', ' ')}</option>)
        }</select
      >
    </label>
  </div>
  <ol class="writing-list">
    {
      posts.map((post) => (
        <li data-writing-tags={post.data.tags.join(',')}>
          <article class="writing-entry">
            <time class="writing-date" datetime={post.data.date.toISOString()}>
              {date.format(post.data.date)}
            </time>
            <div>
              <h2>
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
              <small>
                {post.data.pillar} · {post.data.readingTime} read
              </small>
            </div>
          </article>
        </li>
      ))
    }
  </ol>
  <script is:inline>
    (() => {
      const select = document.getElementById('writing-topic');
      const entries = [...document.querySelectorAll('[data-writing-tags]')];
      const count = document.getElementById('writing-count');
      const apply = () => {
        let visible = 0;
        entries.forEach((entry) => {
          entry.hidden =
            Boolean(select.value) && !entry.dataset.writingTags.split(',').includes(select.value);
          if (!entry.hidden) visible++;
        });
        count.textContent = `${visible} ${visible === 1 ? 'article' : 'articles'}`;
        const url = new URL(location.href);
        if (select.value) url.searchParams.set('tag', select.value);
        else url.searchParams.delete('tag');
        history.replaceState(null, '', url);
      };
      const initial = new URLSearchParams(location.search).get('tag');
      if ([...select.options].some((option) => option.value === initial)) select.value = initial;
      select.addEventListener('change', apply);
      apply();
    })();
  </script>
</BlogLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import PromptPracticeDemo from '../../islands/PromptPracticeDemo';
import { projects } from '../../data/projects';
import stories from '../../data/project-stories.json';

export function getStaticPaths() {
  return Object.entries(stories).map(([id, story]) => ({
    params: { id },
    props: { project: projects.find((p) => p.id === id), story },
  }));
}
const { project, story } = Astro.props;
if (!project) return Astro.redirect('/404');
const next = projects[(projects.findIndex((p) => p.id === project.id) + 1) % projects.length];
---

<BaseLayout title={`${project.name} — Tomas Brasca`} description={project.description}>
  <div class="project-showcase shell" data-project={project.id}>
    <main id="main">
      <section class="intro">
        <div class="eyebrow"><span>{project.category}</span><span>{story.status}</span></div>
        <h1>{project.name}<span>{story.subtitle}</span></h1>
        <div class="summary">
          <p>{project.description}</p><dl>
            <div><dt>My role</dt><dd>{story.role}</dd></div><div>
              <dt>Built with</dt><dd>{project.stack}</dd>
            </div>
          </dl>
        </div>
        <div class="actions">
          {
            story.demo && (
              <a class="primary" href="#in-action">
                Watch the demo ↓
              </a>
            )
          }
          {
            story.media.length > 0 && (
              <a class="primary" href="#in-action">
                Explore the showcase ↓
              </a>
            )
          }
          {
            project.id === '60-seconds' && (
              <a class="primary" href="#in-action">
                Try the sample ↓
              </a>
            )
          }
          {
            project.id === 'letterboxd' && (
              <a href="/previews/letterboxd/sample-story.pdf">Open the full booklet </a>
            )
          }
          {
            project.id === 'a2ui' && (
              <a class="primary" href="/#playground">
                Open the playground
              </a>
            )
          }
          {
            project.website && project.id !== 'a2ui' && (
              <a href={project.website}>Visit website </a>
            )
          }
          {project.source && <a href={project.source}>View source </a>}
        </div>
      </section>
      <section id="in-action" class="media-section" aria-label={`${project.name} showcase`}>
        {
          project.id === '60-seconds' ? (
            <PromptPracticeDemo client:load />
          ) : story.demo ? (
            <figure class="demo-video">
              <>
                <video controls playsinline preload="metadata" poster="/previews/catcher.jpg">
                  <>
                    <source src={story.demo} type="video/mp4" />
                    <a href={story.demo}>Download the product demonstration</a>
                  </>
                </video>
                <figcaption>
                  Actual extension recording · Select a component, capture it, open the library.
                </figcaption>
              </>
            </figure>
          ) : story.media.length ? (
            <div class="media-gallery" data-gallery>
              <div class="gallery-views">
                {story.media.map((media, index) => (
                  <figure data-slide hidden={index !== 0}>
                    <a
                      href={media.src}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={`Open full image: ${media.caption}`}
                    >
                      <img
                        src={media.src}
                        alt={media.caption}
                        loading={index === 0 ? 'eager' : 'lazy'}
                      />
                    </a>
                    <figcaption>
                      {media.caption}
                      <span>Open image </span>
                    </figcaption>
                  </figure>
                ))}
              </div>
              {story.media.length > 1 && (
                <div class="gallery-controls" aria-label="Choose a screenshot">
                  {story.media.map((media, index) => (
                    <button type="button" data-slide-button={index} aria-pressed={index === 0}>
                      <img src={media.src} alt="" loading="lazy" />
                      <span>{String(index + 1).padStart(2, '0')}</span>
                    </button>
                  ))}
                </div>
              )}
            </div>
          ) : (
            <div class="cover">
              <>
                <ProjectPreview project={project} />
                <p>Illustrated project cover</p>
              </>
            </div>
          )
        }
        <p class="media-note">{story.note}</p>
        {
          project.id === '60-seconds' && import.meta.env.DEV && (
            <p class="local-demo">
              <a href="http://localhost:4330" target="_blank" rel="noreferrer">
                Open the original application’s local demo
              </a>
            </p>
          )
        }
      </section>
      <section class="story-grid">
        <div class="story-label"><span>Behind the interface</span><h2>What I worked on.</h2></div>
        <div class="story-copy">
          <p class="lede">{story.story}</p><ul>
            {story.contribution.map((item) => <li>{item}</li>)}
          </ul>{
            project.caseStudy && (
              <a class="case-link" href={project.caseStudy}>
                Read the engineering case study
              </a>
            )
          }
        </div>
      </section>
      <section class="workflow" aria-labelledby="workflow-title">
        <div class="workflow-heading">
          <span>The product flow</span><h2 id="workflow-title">From input to something useful.</h2>
        </div>
        <ol>
          {
            story.flow.map((step, i) => (
              <li>
                <>
                  <span>{String(i + 1).padStart(2, '0')}</span>
                  <h3>{step}</h3>

                </>
              </li>
            ))
          }
        </ol>
      </section>
      <a class="next-project" href={`/showcase/${next.id}`}
        ><span>Up next</span><strong>{next.name}</strong></a
      >
    </main>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const slides = gallery.querySelectorAll<HTMLElement>('[data-slide]');
    const buttons = gallery.querySelectorAll<HTMLButtonElement>('[data-slide-button]');
    buttons.forEach((button, index) =>
      button.addEventListener('click', () => {
        slides.forEach((slide, i) => {
          slide.hidden = i !== index;
        });
        buttons.forEach((control, i) => control.setAttribute('aria-pressed', String(i === index)));
      }),
    );
  });
</script>

<style>
  .project-showcase .intro h1 {
    font-weight: 500;
  }
  .project-showcase .intro h1 span {
    font-style: italic;
    color: var(--blue);
  }
  .project-showcase .story-label h2,
  .project-showcase .workflow-heading h2 {
    font-family: var(--sans);
    font-weight: 500;
    letter-spacing: -0.055em;
  }
  .project-showcase .story-label > span,
  .project-showcase .workflow-heading > span {
    color: var(--blue);
    font-weight: 700;
  }
  .project-showcase .next-project {
    border-top: 1px solid var(--ink);
  }
  .project-showcase .next-project b {
    color: var(--blue);
  }

  .project-showcase {
    color: var(--ink);
    min-height: 100vh;
  }
  .project-showcase a {
    color: inherit;
    text-decoration: none;
  }
  .project-showcase a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .project-showcase :focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 5px;
  }
  .intro {
    padding: 76px 0 44px;
  }
  .eyebrow {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 30px;
  }
  .intro h1 {
    font-size: clamp(54px, 7vw, 96px);
    letter-spacing: -0.065em;
    line-height: 1.02;
    font-weight: 500;
    margin: 0 0 34px;
  }
  .intro h1 span {
    display: block;
    font-family: 'Newsreader Variable', Georgia, serif;
    font-size: clamp(30px, 4vw, 52px);
    letter-spacing: -0.035em;
    line-height: 1.15;
    font-weight: 400;
    color: var(--blue);
    font-style: italic;
    margin-top: 12px;
  }
  .summary {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 9%;
    align-items: start;
  }
  .summary > p {
    font-size: 19px;
    line-height: 1.6;
    margin: 0;
    max-width: 44ch;
  }
  .summary dl {
    margin: 0;
    display: grid;
    gap: 20px;
  }
  .summary dl div {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 16px;
    font-size: 13px;
  }
  .summary dt {
    color: var(--muted);
  }
  .summary dd {
    margin: 0;
    line-height: 1.6;
  }
  .actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 30px;
    font-size: 13px;
  }
  .actions a {
    padding: 12px 18px;
    border: 1px solid var(--line);
    border-radius: 0;
  }
  .actions .primary {
    background: var(--blue);
    color: #fff;
    border-color: var(--blue);
  }
  .media-gallery,
  .demo-video {
    margin: 0;
  }
  .gallery-views {
    background: var(--blue);
    padding: 24px;
    border: 1px solid var(--ink);
    border-radius: 0;
  }
  .gallery-views figcaption {
    color: var(--paper) !important;
  }
  .media-gallery figure {
    margin: 0;
  }
  .media-gallery figure[hidden] {
    display: none;
  }
  .media-gallery figure > a {
    display: block;
  }
  .media-gallery figure img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 650px;
    object-fit: contain;
  }
  .media-gallery figcaption,
  .demo-video figcaption {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font-size: 12px;
    padding-top: 18px;
    color: var(--muted);
    line-height: 1.5;
  }
  .media-gallery figcaption span {
    flex-shrink: 0;
  }
  .gallery-controls {
    display: flex;
    gap: 12px;
    margin-top: 14px;
    overflow-x: auto;
    padding: 3px;
  }
  .gallery-controls button {
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 0;
    padding: 5px;
    display: flex;
    gap: 12px;
    align-items: center;
    color: var(--muted);
    font: inherit;
    font-size: 12px;
    min-width: 100px;
  }
  .gallery-controls button[aria-pressed='true'] {
    border-color: var(--ink);
    box-shadow: 0 0 0 1px var(--ink);
    color: var(--ink);
  }
  .gallery-controls img {
    height: 50px;
    width: 76px;
    object-fit: cover;
  }
  .demo-video video {
    display: block;
    width: 100%;
    max-height: 700px;
    background: #111;
    border-radius: 0;
  }
  .media-note {
    max-width: 85ch;
    font-size: 12px;
    line-height: 1.65;
    color: var(--muted);
    margin: 20px 0 0;
  }
  .local-demo {
    font-size: 13px;
  }
  .cover :global(.product-preview) {
    height: auto;
    min-height: 360px;
    aspect-ratio: 16/7;
  }
  .cover :global(.preview-stage) {
    min-height: 340px;
  }
  .cover > p {
    font-size: 12px;
    color: var(--muted);
    margin: 10px 0;
  }
  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 10%;
    padding: 80px 0;
    border-bottom: 1px solid var(--line);
  }
  .story-label > span,
  .workflow-heading > span {
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .story-label h2,
  .workflow-heading h2 {
    font-family: 'Newsreader Variable', Georgia, serif;
    font-size: 38px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 16px 0;
  }
  .lede {
    font-size: 19px;
    line-height: 1.7;
    margin: 0 0 26px;
  }
  .story-copy ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .story-copy li {
    font-size: 15px;
    line-height: 1.7;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .case-link {
    display: inline-block;
    margin-top: 24px;
    font-size: 14px;
    border-bottom: 1px solid currentColor;
    padding-bottom: 4px;
  }
  .workflow {
    padding: 64px 0 72px;
  }
  .workflow ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .workflow li {
    padding: 26px 28px 28px 0;
    position: relative;
  }
  .workflow li + li {
    border-left: 1px solid var(--line);
    padding-left: 28px;
  }
  .workflow li > span {
    font:
      11px 'JetBrains Mono Variable',
      monospace;
    color: var(--muted);
  }
  .workflow li h3 {
    font-size: 20px;
    font-weight: 500;
    max-width: 20ch;
    line-height: 1.3;
    letter-spacing: -0.03em;
    margin: 20px 20px 0 0;
  }
  .workflow li b {
    position: absolute;
    right: 22px;
    top: 22px;
    font-weight: 400;
    color: var(--muted);
  }
  .next-project {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    padding: 32px 0 50px;
  }
  .next-project > span {
    grid-column: 1/-1;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .next-project strong {
    font-size: clamp(36px, 5vw, 66px);
    font-weight: 400;
    letter-spacing: -0.05em;
  }
  .next-project b {
    font-size: 45px;
    font-weight: 400;
  }
  @media (max-width: 700px) {
    .intro {
      padding-top: 48px;
    }
    .summary,
    .story-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .eyebrow {
      font-size: 10px;
      gap: 16px;
    }
    .summary dl div {
      grid-template-columns: 85px 1fr;
    }
    .gallery-views {
      padding: 10px;
    }
    .media-gallery figcaption span {
      display: none;
    }
    .gallery-controls button {
      min-width: 84px;
    }
    .gallery-controls img {
      width: 50px;
      height: 35px;
    }
    .story-grid {
      padding: 48px 0;
    }
    .workflow {
      padding: 44px 0;
    }
    .workflow ol {
      grid-template-columns: 1fr;
    }
    .workflow li + li {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-left: 0;
    }
    .workflow li {
      padding: 20px 0;
    }
    .workflow li h3 {
      margin-top: 10px;
    }
    .workflow li b {
      right: 0;
    }
    .cover :global(.product-preview) {
      min-height: 240px;
      aspect-ratio: 16/11;
    }
    .cover :global(.preview-stage) {
      min-height: 240px;
    }
  }
</style>

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Rail from '../components/Rail.astro';
import Footer from '../components/Footer.astro';
import Keybar from '../components/Keybar.astro';
import A2UIPlayground from '../islands/A2UIPlayground';
import { profile, proofs, tenets, toolbox, log, now } from '../data/site';
import { repos } from '../data/repos';
import ReelHead from '../reels/ReelHead.astro';
import Stages from '../reels/Stages.astro';
import Opening from '../reels/Opening.astro';
import Projector from '../reels/Projector.astro';
import BoxOffice from '../reels/boxoffice/BoxOffice.astro';
import '../reels/reels.css';

// Work index: single source of truth is the `work` collection (also the case-study pages).
const work = await Promise.all(
  (await getCollection('work', ({ data }) => !data.draft))
    .sort((a, b) => a.data.n.localeCompare(b.data.n))
    .map(async (entry) => {
      const { Content } = await render(entry);
      return { entry, Content };
    }),
);

// Writing section: homepage curates a hand-picked set, in this order.
const FEATURED = [
  'evals-are-contracts',
  'binary-search-on-the-answer',
  'data-structures-typescript-python',
  'the-unglamorous-middle',
];
const byId = new Map(
  (await getCollection('blog', ({ data }) => !data.draft)).map((p) => [p.id, p]),
);
const posts = FEATURED.map((id) => byId.get(id)).filter((p) => p !== undefined);

const iso = (d: Date) => d.toISOString().slice(0, 10);
const COMMITS = 'https://github.com/soundOfff/personal-site/commit/';
---

<BaseLayout
  description="Tomas Brasca, a software engineer in Rosario, Argentina. Web and mobile apps, LLM routing at Dex, and e-commerce APIs for Mint Mobile."
>
  <ReelHead slot="head" />
  <Stages at="backdrop" />
  <div class="shell">
    <Rail />

    <main class="content">
      {/* 00 · readme */}
      <section class="block" id="readme" data-sec="0">
        <Opening />
        <Keybar sec="readme" label="about" />
        <p class="lede" set:html={profile.lede} />
        <p class="sub">{profile.sub}</p>
        <div class="metrics">
          {
            proofs.map((m) => (
              <div class="m">
                <div class="v">{m.accent ? <em>{m.value}</em> : m.value}</div>
                <div class="k">{m.key}</div>
              </div>
            ))
          }
        </div>
      </section>

      {/* 01 · playground (the one interactive island) */}
      <section class="block" id="playground" data-sec="1">
        <Stages at="in:playground" />
        <Keybar sec="playground" label="playground">ask about my work</Keybar>
        <A2UIPlayground client:visible />
      </section>
      <Stages at="after:playground" />

      {/* 02 · work · index */}
      <section class="block" id="work" data-sec="2">
        <Stages at="in:work" />
        <Keybar sec="work" label="work" />
        <table class="idx">
          <tbody>
            {
              work.map(({ entry: w, Content }) => (
                <tr data-href={`/work/${w.id}`}>
                  <td class="n">{w.data.n}</td>
                  <td class="proj">
                    <a href={`/work/${w.id}`}>
                      <b>{w.data.title}</b>
                    </a>
                    <span>{w.data.description}</span>
                    <template data-esper-case>
                      <Content />
                    </template>
                  </td>
                  <td class="stk">{w.data.stack}</td>
                  <td class="yr">{w.data.year}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>
      <Stages at="after:work" />

      {/* 03 · recent projects */}
      <section class="block" id="oss" data-sec="3">
        <Stages at="in:oss" />
        <Keybar sec="oss" label="recent projects" />
        <div class="repos">
          {
            repos.map((r) => {
              const Tag = r.private ? 'article' : 'a';
              return (
                <Tag
                  class="repo"
                  href={r.private ? undefined : r.href}
                  target={r.private ? undefined : '_blank'}
                  rel={r.private ? undefined : 'noopener noreferrer'}
                >
                  <span class="nm">{r.name}</span>
                  <span class="meta">
                    {r.private && <span class="repo-visibility">Private</span>}
                    <span class="lang">
                      <span class="sw" style={`background:${r.color}`} />
                      {r.language}
                    </span>
                  </span>
                  <span class="desc">{r.description}</span>
                </Tag>
              );
            })
          }
        </div>
      </section>
      <Stages at="after:oss" />

      {/* 04 · log · recent activity */}
      <section class="block" id="log" data-sec="4">
        <Stages at="in:log" />
        <Keybar sec="log" label="log" />
        <div class="log">
          {
            log.map((item) => (
              <div class:list={['logitem', item.upcoming && 'upcoming']}>
                <div class="gutter">
                  <span class="ln" />
                  <span class="node" />
                </div>
                <div class="lbody">
                  <div class="top">
                    {item.hash && (
                      <a
                        class="hash"
                        href={`${COMMITS}${item.hash}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`commit ${item.hash} on GitHub`}
                      >
                        {item.hash}
                      </a>
                    )}
                    <span class="date">{item.date}</span>
                    <span class="tag">{item.tag}</span>
                  </div>
                  <div class="msg">
                    {item.msg}
                    {item.link && (
                      <>
                        <span class="sep"> · </span>
                        <a
                          href={item.link.href}
                          target={item.link.href.startsWith('http') ? '_blank' : undefined}
                          rel={
                            item.link.href.startsWith('http') ? 'noopener noreferrer' : undefined
                          }
                        >
                          {item.link.label}
                        </a>
                      </>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>
      <Stages at="after:log" />

      {/* 05 · writing */}
      <section class="block" id="writing" data-sec="5">
        <Stages at="in:writing" />
        <Keybar sec="writing" label="blog"><a href="/blog">all posts</a></Keybar>
        <div class="wlist">
          {
            posts.map((post) => (
              <a class="wrow" href={`/blog/${post.id}`}>
                <span class="d">{iso(post.data.date)}</span>
                <span class="t">{post.data.title}</span>
                <span class="rt">{post.data.readingTime}</span>
              </a>
            ))
          }
        </div>
      </section>
      <Stages at="after:writing" />

      {/* 06 · principles · how I build */}
      <section class="block" id="principles" data-sec="6">
        <Stages at="in:principles" />
        <Keybar sec="principles" label="how I work" />
        <div class="tenets">
          {
            tenets.map((t, i) => (
              <div class="tenet">
                <div class="nn">{String(i + 1).padStart(2, '0')}</div>
                <h3>{t.title}</h3>
                <p>{t.body}</p>
              </div>
            ))
          }
        </div>
      </section>
      <Stages at="after:principles" />

      {/* 07 · stack · toolbox */}
      <section class="block" id="stack" data-sec="7">
        <Stages at="in:stack" />
        <Keybar sec="stack" label="tools" />
        <div class="toolbox">
          {
            toolbox.map((col) => (
              <div class="toolcol">
                <div class="h">{col.h}</div>
                <ul>
                  {col.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
      <Stages at="after:stack" />

      {/* 08 · now */}
      <section class="block" id="now" data-sec="8">
        <Stages at="in:now" />
        <Keybar sec="now" label="now" />
        <dl class="specs">
          {
            now.map((s) => (
              <div class="spec">
                <dt>{s.dt}</dt>
                <dd>{s.dd}</dd>
              </div>
            ))
          }
        </dl>
      </section>
      <Stages at="after:now" />

      <Stages at="credits" />
      <Footer />
    </main>
  </div>

  <Projector />
  <BoxOffice />

  {/* the reel engine: films load on demand; House lights loads nothing else */}
  <script>
    import { boot } from '../reels/engine';
    import { bootBoxOffice } from '../reels/boxoffice/boxoffice';
    boot();
    bootBoxOffice();
  </script>

  {/* progressive enhancement: make work-index rows clickable */}
  <script is:inline>
    document.querySelectorAll('.idx tr[data-href]').forEach((row) => {
      row.addEventListener('click', (e) => {
        if (e.target.closest('a')) return;
        window.location.href = row.getAttribute('data-href');
      });
    });
  </script>
</BaseLayout>

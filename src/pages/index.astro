---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelSigil from '../components/PixelSigil.astro';
import WorkCard from '../components/WorkCard.astro';
import WorkflowWorld from '../components/WorkflowWorld.astro';
import PostCard from '../components/PostCard.astro';
import { projects, workSlug } from '../data/projects';
import stories from '../data/project-stories.json';
import { publicPosts } from '../lib/discovery/documents';
import A2UIPlayground from '../islands/A2UIPlayground';
import '../styles/playground.css';

const bio = [
  'I’m a full-stack engineer with 5+ years of experience. I like working across the whole product, understanding the problem, building the interface, and making the backend reliable.',
  'My competitive programming background shapes how I approach unfamiliar problems. I was an ICPC South America finalist and took first place in the GTS algorithmic trading competition.',
  'These days I’m especially interested in AI products, developer tools and systems that help people learn.',
];

const selected = ['sift', 'focus-quote', 'catcher'].map(
  (id) => projects.find((project) => project.id === id)!,
);
const caseStudies = new Map((await getCollection('work')).map((entry) => [entry.id, entry.data]));
const experience = projects
  .filter((project) => project.category === 'Experience')
  .map((project) => ({
    project,
    role: stories[project.id as keyof typeof stories]?.role,
    year: caseStudies.get(workSlug(project))?.year,
  }));
const categories = [...new Set(projects.map((project) => project.category))];
const posts = (await publicPosts()).slice(0, 2);
const words = [['Ideas', 'made'], ['useful.']];
---

<BaseLayout title="Tomas Brasca · Ideas made useful.">
  <main id="main" tabindex="-1">
    <section class="cover playing" aria-label="Interactive flood-fill cover">
      <div class="cover-sticky">
        <canvas
          class="cover-canvas"
          role="img"
          aria-label="A cobalt pixel cave. Move your pointer to trace a shortest path. Click an open cell or press R to restart the flood."
        ></canvas>
        <div class="hero-layout">
          <p class="hero-kicker">Tomas Brasca / Full-stack engineer</p>
          <h1 class="hero-title">
            {
              words.map((line, row) => (
                <span class="hero-line">
                  {line.map((word, i) => (
                    <>
                      <span class="hero-word" style={`--i:${row * 2 + i}`}>
                        <span class="hero-word-text">{word}</span>
                      </span>{' '}
                    </>
                  ))}
                </span>
              ))
            }
          </h1>
        </div>
        <div class="hero-bottom">
          <p class="hero-summary">
            I’m Tomas. I build thoughtful web and mobile products, the APIs behind them, and AI
            systems that make them useful.
          </p>
          <div class="hero-controls">
            <p>
              <span class="path-key"></span>Every good idea finds a path.<br />
              <span class="cover-hint">Move to explore. Click or press R to restart.</span>
            </p>
            <a href="#work">Scroll to see the work <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <span class="cover-index">Rosario, Argentina / UTC−3</span>
      </div>
    </section>
    <div class="dock-glyph"><PixelSigil star /></div>

    <WorkflowWorld />

    <section class="section shell" id="work" aria-labelledby="work-title" data-settle>
      <div class="work-intro">
        <PixelSigil star />
        <p>Thoughtful interfaces.<br />Useful systems. All the way through.</p>
      </div>
      <div class="section-heading">
        <h2 id="work-title">Products <span class="ghost">in focus.</span></h2>
        <p>Independent tools for learning,<br />reading, and making.</p>
      </div>
      <div class="bento">
        {selected.map((project) => <WorkCard project={project} selected />)}
      </div>
    </section>

    <section class="experience" data-on-blue aria-labelledby="experience-title" data-settle>
      <div class="shell">
        <p class="eyebrow">Engineering experience</p>
        <h2 id="experience-title">Built in teams.<br />Shipped in the world.</h2>
        <div class="experience-grid">
          {
            experience.map(({ project, role, year }) => (
              <a class="experience-card" href={`/work/${workSlug(project)}`}>
                <div class="meta">
                  <span>{role}</span>
                  {year && <span>{year}</span>}
                </div>
                <h3>{project.name}</h3>
                <p>{project.description}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section shell" id="index" aria-labelledby="index-title" data-settle>
      <div class="section-heading">
        <h2 id="index-title">The whole<br /><span class="ghost">body of work.</span></h2>
        <p>Products, systems, and smaller experiments. Follow your curiosity.</p>
      </div>
      <div class="index-toolbar">
        <div class="chips" role="group" aria-label="Project categories">
          {
            ['All', ...categories].map((category, i) => (
              <button
                class="chip"
                type="button"
                data-work-filter={category}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {category}
              </button>
            ))
          }
        </div>
        <span class="count" id="project-count" role="status">{projects.length} projects</span>
      </div>
      <div class="projects-grid" id="project-grid">
        {projects.map((project) => <WorkCard project={project} />)}
      </div>
    </section>

    <section class="section shell about" id="readme" aria-labelledby="about-title" data-settle>
      <div>
        <p class="eyebrow">A bit about me</p>
        <h2 id="about-title">Curious by default.<br />Practical by experience.</h2>
        <div class="about-facts">
          <div><span>5+ years</span><p class="meta">building products</p></div>
          <div><span>ICPC</span><p class="meta">South America finalist</p></div>
        </div>
      </div>
      <div class="about-copy">
        {bio.map((paragraph) => <p>{paragraph}</p>)}
        <a href="/cv.pdf" class="small-link" target="_blank" rel="noopener"
          >The longer version: my résumé</a
        >
      </div>
    </section>

    <section class="section shell writing" aria-labelledby="writing-title" data-settle>
      <div class="section-heading">
        <h2 id="writing-title">On <span class="ghost">the page.</span></h2>
        <p>Notes from making things<br />and figuring things out.</p>
      </div>
      <div class="writing-list">
        {posts.map((post) => <PostCard post={post} featured />)}
      </div>
      <a class="journal-cta" href="/blog">(read the journal →)</a>
    </section>

    <section
      id="playground"
      class="playground-section shell"
      aria-labelledby="playground-title"
      data-settle
    >
      <details>
        <summary>
          <div>
            <p class="eyebrow">An interactive experiment</p>
            <h2 id="playground-title">Ask about my work.</h2>
            <p>Ask a question and get a response built from cards, comparisons and diagrams.</p>
          </div>
          <span class="button playground-open"
            >Open the playground <span aria-hidden="true">+</span></span
          >
        </summary>
        <div class="playground-body"><A2UIPlayground client:visible /></div>
      </details>
    </section>
  </main>
</BaseLayout>

<script>
  import { initCover } from '../lib/flood/cover';
  import { reducedMotion } from '../lib/flood/scroll';
  import { initSettle } from '../lib/flood/settle';

  initCover();
  initSettle();

  // Category chips filter the index; cards glide to their new places (FLIP).
  const grid = document.querySelector<HTMLElement>('#project-grid')!;
  const count = document.querySelector<HTMLElement>('#project-count')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-work-filter]')];
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const value = chip.dataset.workFilter;
      const cards = [...grid.children] as HTMLElement[];
      const before = new Map(cards.map((card) => [card, card.getBoundingClientRect()]));
      cards.forEach((card) => (card.hidden = value !== 'All' && card.dataset.category !== value));
      chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
      const visible = cards.filter((card) => !card.hidden);
      count.textContent = `${visible.length} project${visible.length === 1 ? '' : 's'}`;
      if (reducedMotion.matches) return;
      visible.forEach((card) => {
        const old = before.get(card)!;
        const now = card.getBoundingClientRect();
        if (!old.width) return;
        card.animate(
          [
            { transform: `translate(${old.x - now.x}px, ${old.y - now.y}px)` },
            { transform: 'none' },
          ],
          {
            duration: 450,
            easing: 'cubic-bezier(.22,1,.36,1)',
          },
        );
      });
    }),
  );
</script>

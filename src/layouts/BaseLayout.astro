---
// Self-hosted fonts (replaces editorial-ui's Google-Fonts @import for speed).
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';

// editorial-ui design system: tokens first, then the component CSS.
import 'editorial-ui/tokens.css';
import 'editorial-ui/styles.css';

// The flood-fill identity owns the palette, typography and outer layout. Must come last.
import '../styles/flood.css';
import FloodHeader from '../components/FloodHeader.astro';
import FloodFooter from '../components/FloodFooter.astro';
import { ARRIVAL_KEY } from '../lib/flood/transition-key';

import { profile, contact } from '../data/site';
import { pageUrl, siteUrl } from '../lib/site-origin';

// Icon sprite, inlined once per page. Chrome doesn't resolve cross-document
// SVG <use> references, so fragment-only refs (#i-moon) against an inline
// sprite are the only portable option.
import iconSprite from '../assets/icons.svg?raw';

interface Props {
  title?: string;
  description?: string;
  /** OG/Twitter share image, resolved against `site` to an absolute URL. */
  image?: string;
  /** `article` flips og:type and emits article structured data. */
  type?: 'website' | 'article';
  /** ISO date for articles → og:article:published_time + schema datePublished. */
  publishedTime?: string;
  articleKind?: 'BlogPosting' | 'Article';
  headline?: string;
  pageKind?: 'WebPage' | 'ProfilePage' | 'CollectionPage';
  markdownPath?: string;
  /** Keep a page out of the index (used by 404). */
  noindex?: boolean;
}

const {
  title = `${profile.name} · ${profile.role}`,
  description = 'Full-stack engineer who ships AI products end to end: the web and mobile apps and the backend that keeps them running. Ask the agent about the work.',
  image = '/og.png',
  type = 'website',
  publishedTime,
  articleKind = 'Article',
  headline = title,
  pageKind = Astro.url.pathname === '/' ? 'ProfilePage' : 'WebPage',
  markdownPath = Astro.url.pathname === '/' ? '/index.md' : undefined,
  noindex = false,
} = Astro.props;

// Absolute URLs are required by crawlers and social unfurlers.
const rootUrl = siteUrl();
const canonical = pageUrl(Astro.url.pathname);
const ogImage = siteUrl(image);
const rssUrl = siteUrl('/rss.xml');

// Profile links → schema.org `sameAs` (external profiles only).
const sameAs = contact.filter((c) => c.href.startsWith('http')).map((c) => c.href);

const person = {
  '@type': 'Person',
  '@id': `${rootUrl}#person`,
  name: profile.name,
  url: rootUrl,
  jobTitle: profile.role,
  email: 'tomibrasca97@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rosario',
    addressCountry: 'AR',
  },
  knowsAbout: [
    'LLM routing',
    'Backend engineering',
    'AI infrastructure',
    'Evals',
    'Competitive programming',
    'Distributed systems',
  ],
  sameAs,
};

// Page and article entities share one author identity.
const graph: Record<string, unknown>[] = [
  person,
  {
    '@type': 'WebSite',
    '@id': `${rootUrl}#website`,
    url: rootUrl,
    name: `${profile.name} · ${profile.role}`,
    inLanguage: 'en',
    author: { '@id': `${rootUrl}#person` },
    publisher: { '@id': `${rootUrl}#person` },
  },
  {
    '@type': pageKind,
    '@id': canonical,
    url: canonical,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': `${rootUrl}#website` },
    ...(pageKind === 'ProfilePage' ? { mainEntity: { '@id': `${rootUrl}#person` } } : {}),
    ...(pageKind === 'CollectionPage' ? { mainEntity: { '@id': `${canonical}#blog` } } : {}),
    ...(type === 'article' ? { mainEntity: { '@id': `${canonical}#article` } } : {}),
  },
];

if (pageKind === 'CollectionPage') {
  graph.push({
    '@type': 'Blog',
    '@id': `${canonical}#blog`,
    url: canonical,
    name: title,
    description,
    inLanguage: 'en',
    author: { '@id': `${rootUrl}#person` },
    publisher: { '@id': `${rootUrl}#person` },
  });
}

if (type === 'article') {
  graph.push({
    '@type': articleKind,
    '@id': `${canonical}#article`,
    headline,
    ...(articleKind === 'BlogPosting' ? { isPartOf: { '@id': `${pageUrl('/blog')}#blog` } } : {}),
    description,
    url: canonical,
    image: ogImage,
    inLanguage: 'en',
    ...(publishedTime ? { datePublished: publishedTime } : {}),
    author: { '@id': `${rootUrl}#person` },
    publisher: { '@id': `${rootUrl}#person` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  });
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replaceAll(
  '<',
  '\\u003c',
);

const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      markdownPath && (
        <link rel="alternate" type="text/markdown" title="Markdown" href={siteUrl(markdownPath)} />
      )
    }
    {!noindex && <link rel="describedby" type="text/plain" href={siteUrl('/llms.txt')} />}
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f7f3e9" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} · ${profile.role}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && <meta property="article:author" content={rootUrl} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.name} · Writing`}
      href={rssUrl}
    />

    <!-- Page-specific metadata and resources. -->
    <slot name="head" />

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={jsonLd} />

    <!-- Arriving mid route-transition: stay covered until the wave uncovers the page. -->
    <script is:inline define:vars={{ key: ARRIVAL_KEY }}>
      try {
        const motion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const nav = performance.getEntriesByType('navigation')[0];
        if (!motion && (sessionStorage.getItem(key) || nav?.type === 'back_forward')) {
          document.documentElement.classList.add('flood-covered');
        }
      } catch {
        /* ignore */
      }
    </script>
  </head>
  <body>
    <Fragment set:html={iconSprite} />
    <a class="skip" href="#main">Skip to content</a>
    <div id="reading-progress" aria-hidden="true"></div>
    <FloodHeader />
    <slot />
    <FloodFooter />
    <canvas id="transition" aria-hidden="true"></canvas>
    <div id="announcer" class="sr-only" role="status" aria-live="polite"></div>
    <script>
      import { initSite } from '../lib/flood/site';
      import { initTransitions } from '../lib/flood/transition';

      initTransitions();
      initSite();
    </script>
  </body>
</html>

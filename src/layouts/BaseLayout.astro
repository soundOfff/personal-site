---
// Self-hosted fonts (replaces editorial-ui's Google-Fonts @import for speed).
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';

// editorial-ui design system: tokens first, then the component CSS.
import 'editorial-ui/tokens.css';
import 'editorial-ui/styles.css';

// Workbench layer (font-family overrides, base, ported layout). Must come last.
import '../styles/global.css';

import { site, profile, contact } from '../data/site';

// Icon sprite, inlined once per page. Chrome doesn't resolve cross-document
// SVG <use> references, so fragment-only refs (#i-moon) against an inline
// sprite are the only portable option.
import iconSprite from '../assets/icons.svg?raw';

interface Props {
  title?: string;
  description?: string;
  /** OG/Twitter share image, resolved against `site` to an absolute URL. */
  image?: string;
  /** `article` flips og:type and emits BlogPosting/Article structured data. */
  type?: 'website' | 'article';
  /** ISO date for articles → og:article:published_time + schema datePublished. */
  publishedTime?: string;
  /** Keep a page out of the index (used by 404). */
  noindex?: boolean;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = 'Backend engineer who builds the systems that make AI products work in production. Live multi-LLM router demo.',
  image = '/og.png',
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

// Absolute URLs are required by crawlers and social unfurlers.
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const ogImage = new URL(image, siteOrigin).href;
const rssUrl = new URL('/rss.xml', siteOrigin).href;

// Profile links → schema.org `sameAs` (external profiles only).
const sameAs = contact.filter((c) => c.href.startsWith('http')).map((c) => c.href);

const person = {
  '@type': 'Person',
  '@id': `${siteOrigin.href}#person`,
  name: profile.name,
  url: siteOrigin.href,
  image: ogImage,
  jobTitle: profile.role,
  email: 'tomibrasca97@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rosario',
    addressCountry: 'AR',
  },
  knowsAbout: [
    'LLM routing',
    'Backend engineering',
    'AI infrastructure',
    'Evals',
    'Competitive programming',
    'Distributed systems',
  ],
  sameAs,
};

// @graph lets a Person, WebSite, and (for posts) an Article coexist cleanly.
const graph: Record<string, unknown>[] = [
  person,
  {
    '@type': 'WebSite',
    '@id': `${siteOrigin.href}#website`,
    url: siteOrigin.href,
    name: `${profile.name} — ${profile.role}`,
    description,
    inLanguage: 'en',
    author: { '@id': `${siteOrigin.href}#person` },
    publisher: { '@id': `${siteOrigin.href}#person` },
  },
];

if (type === 'article') {
  graph.push({
    '@type': 'BlogPosting',
    '@id': `${canonical}#article`,
    headline: title,
    description,
    url: canonical,
    image: ogImage,
    inLanguage: 'en',
    ...(publishedTime ? { datePublished: publishedTime, dateModified: publishedTime } : {}),
    author: { '@id': `${siteOrigin.href}#person` },
    publisher: { '@id': `${siteOrigin.href}#person` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  });
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });

const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FBFAF6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1B1814" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && <meta property="article:author" content={profile.name} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.name} — Writing`}
      href={rssUrl}
    />

    <!-- Structured data (Person + WebSite, plus Article on posts). -->
    <script type="application/ld+json" is:inline set:html={jsonLd} />

    <!-- No-FOUC theme bootstrap: set data-theme before first paint. -->
    <script is:inline define:vars={{ key: site.themeKey }}>
      try {
        const t = localStorage.getItem(key);
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch {
        /* ignore */
      }
    </script>
  </head>
  <body>

    <Fragment set:html={iconSprite} />
    <slot />

    <!-- Theme toggle: flip data-theme, persist, swap the moon/sun glyph. -->
    <script is:inline define:vars={{ key: site.themeKey }}>
      (function () {
        const root = document.documentElement;
        const current = () =>
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const apply = (theme) => {
          root.dataset.theme = theme;
          document.querySelectorAll('[data-theme-icon]').forEach((u) => {
            u.setAttribute('href', theme === 'dark' ? '#i-sun' : '#i-moon');
          });
        };
        apply(current());
        document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const next = current() === 'dark' ? 'light' : 'dark';
            try {
              localStorage.setItem(key, next);
            } catch {
              /* ignore */
            }
            apply(next);
          });
        });
      })();
    </script>
  </body>
</html>

---
import BaseLayout from './BaseLayout.astro';
import '../styles/reading.css';
interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  headline?: string;
  markdownPath: string;
}
const { title, description, type = 'website', publishedTime, headline, markdownPath } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  type={type}
  publishedTime={publishedTime}
  headline={headline}
  articleKind="BlogPosting"
  pageKind={type === 'website' ? 'CollectionPage' : 'WebPage'}
  markdownPath={markdownPath}
>
  <main id="main" class="reading-shell shell" tabindex="-1"><slot /></main>
</BaseLayout>

@@ -96,6 +96,91 @@ function sprinkle(root: HTMLElement, motion: boolean): () => void {
 
 /* ------------------------------------------------------------------ */
 
+function memoryArchive(ctx: ReelContext): () => void {
+  const table = document.querySelector<HTMLElement>('#work .idx');
+  const template = document.querySelector<HTMLTemplateElement>('[data-br-memory-template]');
+  const source = template?.content.firstElementChild;
+  if (!table || !(source instanceof HTMLElement)) return () => {};
+  const rows = [...table.querySelectorAll<HTMLElement>('tr')];
+  if (!rows.length) return () => {};
+  const panel = source.cloneNode(true);
+  if (!(panel instanceof HTMLElement)) return () => {};
+  const name = panel.querySelector<HTMLElement>('[data-br-memory-name]');
+  const count = panel.querySelector<HTMLElement>('[data-br-memory-count]');
+  table.before(panel);
+  table.classList.add('br-memory-rack');
+  let selected: HTMLElement | null = null;
+  let pointer: HTMLElement | null = null;
+  let frame = 0;
+  const select = (row: HTMLElement) => {
+    if (row === selected) return;
+    selected?.classList.remove('is-recalled');
+    selected = row;
+    row.classList.add('is-recalled');
+    if (name) name.textContent = row.querySelector('.proj b')?.textContent ?? '';
+    if (count) count.textContent = `${pad(rows.indexOf(row) + 1)} / ${pad(rows.length)}`;
+  };
+  const update = () => {
+    frame = 0;
+    if (ctx.signal.aborted) return;
+    const bounds = table.getBoundingClientRect();
+    if (bounds.bottom < 0 || bounds.top > innerHeight) return;
+    const focused = rows.find((row) => row.contains(document.activeElement));
+    const inspected = focused ?? pointer;
+    if (inspected) {
+      select(inspected);
+      return;
+    }
+    let nearest: HTMLElement | null = null;
+    let distance = Infinity;
+    for (const row of rows) {
+      const center = bounds.top + row.offsetTop + row.offsetHeight / 2;
+      const next = Math.abs(center - innerHeight * 0.48);
+      if (next < distance) {
+        distance = next;
+        nearest = row;
+      }
+    }
+    if (nearest) select(nearest);
+  };
+  const schedule = () => {
+    if (!frame && !ctx.signal.aborted) frame = requestAnimationFrame(update);
+  };
+  rows.forEach((row) => {
+    row.addEventListener(
+      'pointerenter',
+      (event) => {
+        if (event.pointerType !== 'mouse') return;
+        pointer = row;
+        schedule();
+      },
+      { signal: ctx.signal },
+    );
+    row.addEventListener(
+      'pointerleave',
+      () => {
+        pointer = null;
+        schedule();
+      },
+      { signal: ctx.signal },
+    );
+    row.addEventListener('focusin', schedule, { signal: ctx.signal });
+    row.addEventListener('focusout', schedule, { signal: ctx.signal });
+  });
+  window.addEventListener('scroll', schedule, { passive: true, signal: ctx.signal });
+  window.addEventListener('resize', schedule, { passive: true, signal: ctx.signal });
+  const observer = new ResizeObserver(schedule);
+  observer.observe(table);
+  update();
+  return () => {
+    cancelAnimationFrame(frame);
+    observer.disconnect();
+    table.classList.remove('br-memory-rack');
+    rows.forEach((row) => row.classList.remove('is-recalled'));
+    panel.remove();
+  };
+}

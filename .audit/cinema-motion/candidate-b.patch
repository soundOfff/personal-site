+function houseSection(ctx: ReelContext): () => void {
+  const house = document.querySelector<HTMLElement>('.px-house-section');
+  const person = house?.querySelector<SVGCircleElement>('[data-px-person]');
+  const trace = house?.querySelector<SVGPathElement>('.px-section-trace');
+  const depth = house?.querySelector<HTMLElement>('[data-px-depth]');
+  if (!house || !person || !trace) return () => {};
+
+  const sections = SECTION_IDS.map((id) => document.getElementById(id));
+  const rooms = [...house.querySelectorAll<SVGGElement>('[data-px-room]')];
+  const distance = trace.getTotalLength();
+  const positions = [0, 0.17, 0.34, 0.45, 0.54, 0.65, 0.73, 0.87, 1];
+  const depthLabels = ['+1F', 'stairs', '−B1', '−B2'];
+  let frame = 0;
+  const update = () => {
+    frame = 0;
+    if (ctx.signal.aborted) return;
+    const index = clampSec(ctx.section());
+    const current = sections[index];
+    const next = sections[index + 1];
+    let progress = 0;
+    if (!ctx.reducedMotion && current && next) {
+      const top = current.getBoundingClientRect().top;
+      const span = next.getBoundingClientRect().top - top;
+      progress = Math.max(0, Math.min(1, (innerHeight * 0.35 - top) / Math.max(1, span)));
+    }
+    const from = positions[index] ?? 0;
+    const to = positions[index + 1] ?? from;
+    const point = trace.getPointAtLength((from + (to - from) * progress) * distance);
+    person.setAttribute('cx', point.x.toFixed(2));
+    person.setAttribute('cy', point.y.toFixed(2));
+    const floor = floorOf(index);
+    rooms.forEach((room, i) => room.classList.toggle('is-current', i === floor));
+    if (depth) depth.textContent = depthLabels[floor] ?? '';
+  };
+  const schedule = () => {
+    if (!frame && !ctx.signal.aborted) frame = requestAnimationFrame(update);
+  };
+  const offSection = ctx.onSection(schedule);
+  if (!ctx.reducedMotion)
+    window.addEventListener('scroll', schedule, { passive: true, signal: ctx.signal });
+  window.addEventListener('resize', schedule, { passive: true, signal: ctx.signal });
+  update();
+  const stop = () => {
+    cancelAnimationFrame(frame);
+    offSection();
+    rooms.forEach((room) => room.classList.remove('is-current'));
+    person.setAttribute('cx', '28');
+    person.setAttribute('cy', '38');
+    if (depth) depth.textContent = '+1F';
+  };
+  ctx.signal.addEventListener('abort', stop, { once: true });
+  return stop;
+}

+    const memories = new Set<HTMLAnchorElement>();
+    const originalLabels = new Map<HTMLAnchorElement, string | null>();
+    const memoryObserver = new IntersectionObserver(
+      (entries) => {
+        for (const entry of entries) {
+          if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) continue;
+          const tick = ticks.find((a) => a.hash === `#${entry.target.id}`);
+          if (!(tick instanceof HTMLAnchorElement) || memories.has(tick)) continue;
+          memories.add(tick);
+          originalLabels.set(tick, tick.getAttribute('aria-label'));
+          tick.dataset.brMemory = 'recalled';
+          const index = ticks.indexOf(tick);
+          tick.setAttribute('aria-label', `${NAMES[index]}, memory recalled`);
+          if (memoryCount) memoryCount.textContent = `${memories.size} / 9 memories recalled`;
+        }
+      },
+      { rootMargin: '-35% 0px -35% 0px' },
+    );
+    secs.forEach((sec) => memoryObserver.observe(sec));
+    cleanups.push(() => {
+      memoryObserver.disconnect();
+      memories.forEach((tick) => {
+        delete tick.dataset.brMemory;
+        const label = originalLabels.get(tick);
+        if (label === null) tick.removeAttribute('aria-label');
+        else if (label !== undefined) tick.setAttribute('aria-label', label);
+      });
+      if (memoryCount) memoryCount.textContent = initialMemoryCount;

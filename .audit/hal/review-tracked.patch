+    padding-top: 6px;
+    font: 500 13px/1.2 var(--font-mono);
+  }
+  .ps-circuit input {
+    appearance: none;
+    grid-area: 1 / 2 / 3;
+    position: relative;
+    width: 30px;
+    height: 48px;
+    margin: 0;
+    border: 2px solid #3c463a;
+    border-radius: 2px;
+    background: linear-gradient(#e5e5d4 0 49%, #b5b6a6 50%);
+    box-shadow:
+      0 2px 4px #0006,
+      inset 0 -4px 0 #8c9083;
+    cursor: pointer;
+  }
+  .ps-circuit input::after {
+    content: '';
+    position: absolute;
+    width: 9px;
+    height: 2px;
+    top: 8px;
+    left: 8px;
+    background: #4f603a;
+    box-shadow: 0 0 3px #ddeab366;
+  }
+  .ps-circuit input:checked {
+    background: linear-gradient(#858b7b 0 49%, #dedfc9 50%);
+    box-shadow:

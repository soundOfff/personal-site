+    background: linear-gradient(115deg, #c6c4b4, #9e9e91);
+    box-shadow:
+      2px 4px 12px #0008,
+      inset 0 0 0 3px #a7a99a;
+    color: #202a23;
+  }
+  .ps-circuit label {

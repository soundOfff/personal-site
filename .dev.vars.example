# Copy to `.dev.vars` for local live-mode development (git-ignored).
# Leave ANTHROPIC_API_KEY unset and /api/a2ui returns a graceful 503: the
# Playground falls back to its bundled demo transcripts and still works.
ANTHROPIC_API_KEY=

# Optional. The agent defaults to claude-haiku-4-5-20251001 — the smallest model
# that clears the bar, which is the same argument the rest of the site makes.
# Override for a quality/cost trade, e.g. A2UI_MODEL=claude-sonnet-5
A2UI_MODEL=
